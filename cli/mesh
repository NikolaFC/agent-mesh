def git_cmd(root, args, check=True, allow_stderr=False):
    r = subprocess.run(["git"] + args, cwd=str(root), capture_output=True, text=True, timeout=120)
    if check and r.returncode != 0:
        detail = (r.stderr or r.stdout).strip()
        die(f"git {' '.join(args)} failed" + (f": {detail}" if detail else ""))
    if r.stderr.strip() and allow_stderr:
        warn(r.stderr.strip())
    return r


def git_available():
    return shutil.which("git") is not None


def git_top_level(root):
    r = git_cmd(root, ["rev-parse", "--show-toplevel"], check=False)
    if r.returncode != 0:
        return None
    return Path(r.stdout.strip()).resolve()


def root_has_project_content(root):
    allowed = {".mesh", ".git", ".gitignore", ".gitattributes", "README.md", "README.zh-CN.md"}
    try:
        entries = [p.name for p in root.iterdir() if p.name not in allowed]
    except FileNotFoundError:
        return False
    return bool(entries)


def state_sync_config(root):
    config = load_mesh_config(root)
    state = config.get("stateSync") or {}
    if state.get("backend", "git") != "git":
        die("Only stateSync backend 'git' is supported in this version.")
    if state.get("path", ".mesh") != ".mesh":
        die("Only stateSync.path='.mesh' is supported in this version.")
    remote = state.get("remote") or ""
    branch = state.get("branch") or "main"
    return config, state, remote, branch


def write_state_gitignore(root):
    block = (
        "# Agent Mesh local/generated files\n"
        ".mesh/.lock\n"
        ".mesh/.state-sync/\n"
        ".mesh/**/index.jsonl\n"
    )
    path = root / ".gitignore"
    if path.exists():
        text = read_text(path)
        missing = [line for line in block.splitlines() if line and line not in text]
        if missing:
            append_text(path, "\n" + "\n".join(missing) + "\n")
    else:
        write_text(path, block)


def ensure_state_git(root, remote=None, branch="main", allow_project_repo=False):
    if not git_available():
        die("git is required for mesh state sync.")
    top = git_top_level(root)
    if top and top != root.resolve() and not allow_project_repo:
        die(
            "Refusing to use a parent project Git repo as the mesh state backend. "
            "Create a dedicated state root and set MESH_ROOT, or pass --allow-project-repo if you really intend this."
        )
    if root_has_project_content(root) and not allow_project_repo:
        die(
            "Refusing to use a non-empty project directory as the mesh state backend. "
            "Recommended: create a dedicated state repo (for example ~/agent-mesh-state) and set MESH_ROOT to it."
        )
    if not (root / ".git").exists():
        git_cmd(root, ["init"])
    git_cmd(root, ["checkout", "-B", branch])
    if remote:
        existing = git_cmd(root, ["remote", "get-url", "origin"], check=False)
        if existing.returncode == 0:
            git_cmd(root, ["remote", "set-url", "origin", remote])
        else:
            git_cmd(root, ["remote", "add", "origin", remote])
    write_state_gitignore(root)


def git_commit_pending(root, message):
    paths = [".mesh"]
    if (root / ".gitignore").exists():
        paths.append(".gitignore")
    git_cmd(root, ["add", "-A"] + paths)
    diff = git_cmd(root, ["diff", "--cached", "--quiet"], check=False)
    if diff.returncode == 0:
        return False
    git_cmd(root, [
        "-c", "user.name=agent-mesh",
        "-c", "user.email=agent-mesh@noreply",
        "commit", "-m", message,
    ])
    return True


def git_remote_branch_exists(root, branch):
    r = git_cmd(root, ["ls-remote", "--exit-code", "--heads", "origin", branch], check=False)
    return r.returncode == 0


def configure_state_remote(root, remote, branch="main", allow_project_repo=False):
    ensure_mesh_structure(root)
    ensure_state_git(root, remote=remote, branch=branch, allow_project_repo=allow_project_repo)
    config = load_mesh_config(root)
    config.setdefault("stateSync", {})
    config["stateSync"].update({
        "backend": "git",
        "remote": remote,
        "branch": branch,
        "path": ".mesh",
        "ignoreGenerated": True,
    })
    save_mesh_config(root, config)
    return config


def cmd_state_configure(args):
    root = require_mesh_root()
    configure_state_remote(root, args.remote, branch=args.branch, allow_project_repo=args.allow_project_repo)
    success(f"✅ Configured mesh state sync: {args.remote} ({args.branch})")


def clone_state_root(remote, target, branch="main"):
    if not git_available():
        die("git is required for mesh state sync.")
    if target.exists() and any(target.iterdir()):
        die(f"Target is not empty: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    clone = subprocess.run(["git", "clone", "--branch", branch, remote, str(target)], capture_output=True, text=True, timeout=120)
    if clone.returncode != 0:
        # Empty remotes often do not have the requested branch yet; retry without --branch.
        clone = subprocess.run(["git", "clone", remote, str(target)], capture_output=True, text=True, timeout=120)
    if clone.returncode != 0:
        die(f"git clone failed: {(clone.stderr or clone.stdout).strip()}")
    ensure_mesh_structure(target)
    configure_state_remote(target, remote, branch=branch, allow_project_repo=True)
    return target


def cmd_state_clone(args):
    target = Path(args.target).expanduser().resolve()
    clone_state_root(args.remote, target, branch=args.branch)
    success(f"✅ Cloned mesh state root to {target}")
    print(f"Set this for agents that run elsewhere: export MESH_ROOT={target}")


def tailscale_git_remote(host, repo_path, user=None):
    if not host or any(ch.isspace() for ch in host):
        die("Invalid Tailscale host. Use a MagicDNS name or tailnet IP without spaces.")
    if not repo_path or not repo_path.startswith("/"):
        die("--repo-path must be an absolute path on the Tailscale SSH host, e.g. /Users/satoshi/agent-mesh-state.git")
    if user and any(ch.isspace() for ch in user):
        die("Invalid SSH user. Use a username without spaces.")
    prefix = f"{user}@{host}" if user else host
    return f"{prefix}:{repo_path}"


def tailscale_setup_hint(remote, repo_path):
    return (
        "Remote host one-time setup:\n"
        f"  mkdir -p {repo_path}\n"
        f"  git init --bare {repo_path}\n"
        "Then from each participating machine:\n"
        f"  mesh state tailscale configure --host <host> --repo-path {repo_path}\n"
        f"Git remote URL: {remote}"
    )


def is_bare_git_repo(path):
    if not path.exists():
        return False
    r = subprocess.run(["git", "--git-dir", str(path), "rev-parse", "--is-bare-repository"], capture_output=True, text=True, timeout=30)
    return r.returncode == 0 and r.stdout.strip() == "true"


def ensure_bare_repo(path):
    path = path.expanduser().resolve()
    if path.exists() and not is_bare_git_repo(path):
        die(f"Path exists but is not a bare Git repo: {path}")
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        r = subprocess.run(["git", "init", "--bare", str(path)], capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            die(f"git init --bare failed: {(r.stderr or r.stdout).strip()}")
    return path


