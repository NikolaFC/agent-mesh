    p_pulse_update.add_argument("--task", help="Current task ID")
    p_pulse_update.add_argument("--summary", help="Recent action summary")
    p_pulse_update.set_defaults(func=cmd_pulse_update)

    p_pulse_touch = pulse_sub.add_parser("touch", help="Refresh an agent pulse without changing task/status")
    p_pulse_touch.add_argument("--agent", required=True, help="Agent name")
    p_pulse_touch.add_argument("--summary", help="Optional note to append")
    p_pulse_touch.set_defaults(func=cmd_pulse_touch)

    p_pulse_check = pulse_sub.add_parser("check", help="Find stale pulses (>30m)")
