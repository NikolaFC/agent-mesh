def command_requires_lock(args):
    command = getattr(args, "command", None)
    if command == "pulse":
        return getattr(args, "pulse_command", None) in {"update", "touch", "clean"}
    if command == "task":
        return getattr(args, "task_command", None) in {"create", "update", "history", "archive", "assign"}
    if command == "shared":
        return getattr(args, "shared_command", None) in {"append", "update"}
    if command == "doctor":
        return bool(getattr(args, "fix_safe", False))
    if command == "sync":
        return True
    if command == "evolution":
        return getattr(args, "evolution_command", None) in {"log", "compact", "index"}
    if command == "mcp":
        mcp_command = getattr(args, "mcp_command", None)
        if mcp_command == "session":
            return getattr(args, "mcp_session_command", None) in {"register"}
        if mcp_command == "access":
            return getattr(args, "mcp_access_command", None) in {"request", "decide"}
        if mcp_command == "transcript":
            return getattr(args, "mcp_transcript_command", None) in {"read"}
        if mcp_command == "context":
            return getattr(args, "mcp_context_command", None) in {"pack"}
        if mcp_command == "server":
            return getattr(args, "mcp_server_command", None) in {"set", "unset"}
        if mcp_command == "call":
            return True
    if command == "index":
        return True
    if command == "state":
        state_command = getattr(args, "state_command", None)
        if state_command == "tailscale":
            return getattr(args, "tailscale_command", None) in {"configure", "host-init"}
        return state_command in {"configure", "pull", "push", "sync"}
    return False


def main():
    parser = build_parser()
    args = parser.parse_args()

    func = getattr(args, "func", None)
    if func is None:
        parser.print_help()
        raise SystemExit(1)

    if command_requires_lock(args):
        root = detect_mesh_root()
        if root:
            with mesh_lock(root):
                func(args)
            return
    func(args)


if __name__ == "__main__":
    main()
