def cmd_migrate_export(args):
    root = Path(args.root or os.getcwd()).expanduser().resolve()
    plan = collect_migration_plan(root, preset=args.preset, include_skills=args.include_skills, include_memory=args.include_memory)
    if not args.approved_by:
        die("Migration export requires host approval: pass --approved-by <host-agent-or-human>.")
    manifest = migration_manifest(plan, approved_by=args.approved_by)
    output = Path(args.output).expanduser().resolve()
    output.parent.mkdir(parents=True, exist_ok=True)
    with tarfile.open(output, "w:gz") as tar:
        manifest_bytes = json.dumps(manifest, indent=2, ensure_ascii=False).encode("utf-8")
        info_obj = tarfile.TarInfo(MIGRATE_MANIFEST_NAME)
        info_obj.size = len(manifest_bytes)
        info_obj.mtime = int(datetime.datetime.now().timestamp())
        import io
        tar.addfile(info_obj, io.BytesIO(manifest_bytes))
        for item in plan["files"]:
            tar.add(root / item["path"], arcname=item["path"], recursive=False)
    success(f"✅ Exported migration capsule: {output}")
    print(f"Files: {len(plan['files'])}; skipped: {len(plan['skipped'])}; contentHash: {manifest['contentHash']}")


