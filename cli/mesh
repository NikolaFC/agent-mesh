#!/usr/bin/env python3
import argparse
import datetime
import json
import os
import sys
from pathlib import Path

PULSE_SCHEMA_ID = "agent-mesh/pulse/v1"
TASK_SCHEMA_ID = "agent-mesh/task/v1"

PULSE_STATUS = {"idle", "working", "blocked", "reviewing", "done"}
TASK_TYPES = {"upstream-pr", "feature", "bugfix", "investigation", "refactor", "docs", "ops", "research"}
TASK_STATUS = {"open", "in-progress", "blocked", "review", "ci-pass", "ci-fail", "deployed", "merged", "closed", "archived"}
TASK_VERDICTS = {"ADOPT", "REPAIR", "CLOSE", "pending"}
TASK_PRIORITIES = {"critical", "high", "medium", "low"}
TASK_ACTIONS = {"created", "started", "committed", "repaired", "validated", "deployed", "merged", "closed", "commented", "blocked", "unblocked", "tested", "reviewed"}


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_iso(value):
    if not isinstance(value, str):
        return None
    try:
        if value.endswith("Z"):
            value = value[:-1] + "+00:00"
        return datetime.datetime.fromisoformat(value)
    except ValueError:
        return None


def supports_color():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


USE_COLOR = supports_color()


def color(text, code):
    if not USE_COLOR:
        return text
    return f"\033[{code}m{text}\033[0m"


def info(msg):
    print(color(msg, "36"))


def success(msg):
    print(color(msg, "32"))


def warn(msg):
    print(color(msg, "33"))


def fail(msg):
    print(color(msg, "31"), file=sys.stderr)


def die(msg, hint_init=False, code=1):
    fail(f"❌ {msg}")
    if hint_init:
        print("💡 Did you run `mesh init`?", file=sys.stderr)
    raise SystemExit(code)


def detect_mesh_root(start=None):
    # Honour MESH_ROOT env var if set
    env_root = os.environ.get("MESH_ROOT")
    if env_root:
        p = Path(env_root).resolve()
        if (p / ".mesh").is_dir():
            return p
        # If MESH_ROOT points to .mesh/ itself
        if p.is_dir() and p.name == ".mesh" and p.parent:
            return p.parent
    cur = Path(start or os.getcwd()).resolve()
    while True:
        mesh_dir = cur / ".mesh"
        if mesh_dir.is_dir():
            return cur
        parent = cur.parent
        if parent == cur:
            return None
        cur = parent


def require_mesh_root():
    root = detect_mesh_root()
    if not root:
        die("Could not find .mesh directory from current path.", hint_init=True)
    return root


def mesh_paths(root):
    mesh = root / ".mesh"
    return {
        "mesh": mesh,
        "pulse": mesh / "pulse",
        "tasks": mesh / "tasks",
        "active": mesh / "tasks" / "active",
        "archived": mesh / "tasks" / "archived",
        "shared": mesh / "shared",
    }


def read_json(path):
    try:
        with path.open("r", encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        die(f"Missing file: {path}")
    except json.JSONDecodeError as e:
        die(f"Invalid JSON in {path}: {e}")


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")


def read_text(path):
    with path.open("r", encoding="utf-8") as f:
        return f.read()


def write_text(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        f.write(content)


def append_text(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(content)


def is_agent_name(value):
    if not isinstance(value, str):
        return False
    if not value:
        return False
    allowed = "abcdefghijklmnopqrstuvwxyz0123456789-"
    for i, ch in enumerate(value):
        if ch not in allowed:
            return False
        if i == 0 and ch == "-":
            return False
    return True


def is_task_id(value):
    return is_agent_name(value)


def validate_by_schema(data, schema, path="$"):
    errors = []

    stype = schema.get("type")
    if stype:
        if stype == "object" and not isinstance(data, dict):
            return [f"{path}: expected object"]
        if stype == "array" and not isinstance(data, list):
            return [f"{path}: expected array"]
        if stype == "string" and not isinstance(data, str):
            return [f"{path}: expected string"]
        if stype == "number" and not isinstance(data, (int, float)):
            return [f"{path}: expected number"]
        if stype == "boolean" and not isinstance(data, bool):
            return [f"{path}: expected boolean"]

    if "const" in schema and data != schema["const"]:
        errors.append(f"{path}: expected const {schema['const']!r}")

    if "enum" in schema and data not in schema["enum"]:
        errors.append(f"{path}: expected one of {schema['enum']}")

    if isinstance(data, str):
        if "minLength" in schema and len(data) < schema["minLength"]:
            errors.append(f"{path}: length < {schema['minLength']}")
        if "maxLength" in schema and len(data) > schema["maxLength"]:
            errors.append(f"{path}: length > {schema['maxLength']}")
        pattern = schema.get("pattern")
        if pattern == "^[a-z0-9][a-z0-9-]*$":
            if not is_agent_name(data):
                errors.append(f"{path}: does not match pattern {pattern}")
        if schema.get("format") == "date-time" and parse_iso(data) is None:
            errors.append(f"{path}: invalid date-time format")

    if isinstance(data, (int, float)):
        if "minimum" in schema and data < schema["minimum"]:
            errors.append(f"{path}: value < {schema['minimum']}")
        if "maximum" in schema and data > schema["maximum"]:
            errors.append(f"{path}: value > {schema['maximum']}")

    if isinstance(data, list):
        if "maxItems" in schema and len(data) > schema["maxItems"]:
            errors.append(f"{path}: too many items (> {schema['maxItems']})")
        item_schema = schema.get("items")
        if item_schema:
            for idx, item in enumerate(data):
                errors.extend(validate_by_schema(item, item_schema, f"{path}[{idx}]"))

    if isinstance(data, dict):
        required = schema.get("required", [])
        for key in required:
            if key not in data:
                errors.append(f"{path}: missing required field '{key}'")

        props = schema.get("properties", {})
        for key, subschema in props.items():
            if key in data:
                errors.extend(validate_by_schema(data[key], subschema, f"{path}.{key}"))

        additional = schema.get("additionalProperties")
        if isinstance(additional, dict):
            declared = set(props.keys())
            for key, value in data.items():
                if key not in declared:
                    errors.extend(validate_by_schema(value, additional, f"{path}.{key}"))

    return errors


def task_title_from_file(task):
    return task.get("title") or task.get("id") or "(untitled)"


def cmd_init(_args):
    existing = detect_mesh_root()
    if existing and (existing / ".mesh").is_dir() and existing == Path(os.getcwd()).resolve():
        warn(f"📚 Already initialized at {existing / '.mesh'}")
        return

    base = Path(os.getcwd()).resolve()
    mesh = base / ".mesh"
    dirs = [
        mesh / "pulse",
        mesh / "tasks",
        mesh / "tasks" / "active",
        mesh / "tasks" / "archived",
        mesh / "shared",
    ]
    for d in dirs:
        d.mkdir(parents=True, exist_ok=True)

    context_tpl = "# Shared Context\n\nProject context that every agent should read before starting work.\n"
    decisions_tpl = "# Decisions Log\n\nAppend-only architecture and workflow decisions.\n"
    blockers_tpl = "# Blockers\n\nTrack blockers that need human input or cross-agent coordination.\n"

    for name, content in (
        ("context.md", context_tpl),
        ("decisions.md", decisions_tpl),
        ("blockers.md", blockers_tpl),
    ):
        p = mesh / "shared" / name
        if not p.exists():
            write_text(p, content)

    success(f"✅ Initialized Agent Mesh at {mesh}")


def collect_pulse_files(paths):
    return sorted(paths["pulse"].glob("*.json"), key=lambda p: p.name)


def collect_task_files(paths, include_archived=False):
    active = sorted(paths["active"].glob("*.json"), key=lambda p: p.name)
    if not include_archived:
        return active
    archived = sorted(paths["archived"].glob("*.json"), key=lambda p: p.name)
    return active + archived


def cmd_status(_args):
    root = require_mesh_root()
    paths = mesh_paths(root)

    pulse_files = collect_pulse_files(paths)
    task_files = collect_task_files(paths, include_archived=False)

    print("📡 Agents")
    if not pulse_files:
        print("  (none)")
    for pf in pulse_files:
        data = read_json(pf)
        status = data.get("status", "unknown")
        task_id = (data.get("currentTask") or {}).get("id", "-")
        summary = ""
        recent = data.get("recentActions") or []
        if recent and isinstance(recent, list):
            last = recent[-1]
            if isinstance(last, dict) and last.get("summary"):
                summary = f" — {last.get('summary')}"
        icon = {
            "working": "⏳",
            "blocked": "🚫",
            "done": "✅",
            "reviewing": "📋",
            "idle": "📡",
        }.get(status, "📡")
        print(f"  {icon} {data.get('agent', pf.stem)} | {status} | task: {task_id}{summary}")

    print("\n📋 Active Tasks")
    if not task_files:
        print("  (none)")
    for tf in task_files:
        task = read_json(tf)
        icon = "✅" if task.get("status") in {"merged", "closed", "deployed"} else ("🚫" if task.get("status") == "blocked" else "⏳")
        verdict = task.get("verdict", "-")
        print(
            f"  {icon} {task.get('id', tf.stem)} | {task.get('status', '-')} | verdict: {verdict} | assignee: {task.get('assignedTo', '-') }"
        )


def cmd_pulse_read(args):
    root = require_mesh_root()
    paths = mesh_paths(root)

    if args.agent and args.all:
        die("Use either --agent or --all, not both.")

    targets = []
    if args.agent:
        target = paths["pulse"] / f"{args.agent}.json"
        if not target.exists():
            die(f"Pulse not found for agent '{args.agent}'.")
        targets = [target]
    elif args.all:
        targets = collect_pulse_files(paths)
    else:
        targets = collect_pulse_files(paths)

    if not targets:
        warn("📡 No pulse files found.")
        return

    for idx, file in enumerate(targets):
        if idx:
            print("-" * 60)
        data = read_json(file)
        print(json.dumps(data, ensure_ascii=False, indent=2))


def cmd_pulse_update(args):
    if args.status not in PULSE_STATUS:
        die(f"Invalid pulse status '{args.status}'. Allowed: {sorted(PULSE_STATUS)}")
    if not is_agent_name(args.agent):
        die("Invalid agent name. Use lowercase letters, digits, and hyphens.")

    root = require_mesh_root()
    paths = mesh_paths(root)

    pulse_file = paths["pulse"] / f"{args.agent}.json"
    existing = {}
    if pulse_file.exists():
        existing = read_json(pulse_file)

    data = {
        "schema": PULSE_SCHEMA_ID,
        "agent": args.agent,
        "agentType": existing.get("agentType", "custom"),
        "lastUpdate": now_iso(),
        "status": args.status,
        "blockers": existing.get("blockers", []),
        "nextActions": existing.get("nextActions", []),
    }

    if args.task:
        data["currentTask"] = {
            "id": args.task,
            "title": existing.get("currentTask", {}).get("title", args.task),
            "progress": existing.get("currentTask", {}).get("progress", 0.0),
        }

    if args.summary:
        actions = existing.get("recentActions", [])
        if not isinstance(actions, list):
            actions = []
        actions.append({"type": "note", "summary": args.summary, "at": now_iso()})
        data["recentActions"] = actions[-10:]
    elif "recentActions" in existing:
        data["recentActions"] = existing.get("recentActions", [])

    write_json(pulse_file, data)
    success(f"✅ Updated pulse for {args.agent}")


def cmd_pulse_check(_args):
    root = require_mesh_root()
    paths = mesh_paths(root)

    now = datetime.datetime.now(datetime.timezone.utc)
    stale = []

    for pf in collect_pulse_files(paths):
        data = read_json(pf)
        ts = parse_iso(data.get("lastUpdate"))
        if ts is None:
            stale.append((data.get("agent", pf.stem), "invalid timestamp"))
            continue
        age = now - ts.astimezone(datetime.timezone.utc)
        if age > datetime.timedelta(minutes=30):
            mins = int(age.total_seconds() // 60)
            stale.append((data.get("agent", pf.stem), f"{mins}m"))

    if not stale:
        success("✅ All agents updated within 30 minutes")
        return

    warn("🚫 Stale agents (>30m):")
    for agent, age in stale:
        print(f"  - {agent}: {age}")


def load_task(paths, task_id):
    file = paths["active"] / f"{task_id}.json"
    if not file.exists():
        die(f"Task '{task_id}' not found in active tasks.")
    return file, read_json(file)


def cmd_task_create(args):
    if not is_task_id(args.id):
        die("Invalid task id. Use lowercase letters, digits, and hyphens.")
    if args.type not in TASK_TYPES:
        die(f"Invalid task type '{args.type}'. Allowed: {sorted(TASK_TYPES)}")
    if args.priority not in TASK_PRIORITIES:
        die(f"Invalid priority '{args.priority}'. Allowed: {sorted(TASK_PRIORITIES)}")
    if args.assign and not is_agent_name(args.assign):
        die("Invalid assignee. Use lowercase letters, digits, and hyphens.")

    root = require_mesh_root()
    paths = mesh_paths(root)

    task_file = paths["active"] / f"{args.id}.json"
    if task_file.exists() or (paths["archived"] / f"{args.id}.json").exists():
        die(f"Task '{args.id}' already exists.")

    now = now_iso()
    assignee = args.assign or "unassigned"
    task = {
        "schema": TASK_SCHEMA_ID,
        "id": args.id,
        "type": args.type,
        "title": args.title,
        "status": "open",
        "verdict": "pending",
        "priority": args.priority,
        "assignedTo": assignee,
        "createdAt": now,
        "updatedAt": now,
        "progress": 0.0,
        "history": [
            {
                "agent": assignee,
                "action": "created",
                "summary": "Task created",
                "at": now,
            }
        ],
    }
    write_json(task_file, task)
    success(f"✅ Created task {args.id}")


def cmd_task_update(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    task_file, task = load_task(paths, args.id)

    changed = False
    if args.status is not None:
        if args.status not in TASK_STATUS:
            die(f"Invalid status '{args.status}'. Allowed: {sorted(TASK_STATUS)}")
        task["status"] = args.status
        changed = True

    if args.verdict is not None:
        if args.verdict not in TASK_VERDICTS:
            die(f"Invalid verdict '{args.verdict}'. Allowed: {sorted(TASK_VERDICTS)}")
        task["verdict"] = args.verdict
        changed = True

    if args.progress is not None:
        if args.progress < 0 or args.progress > 1:
            die("Progress must be between 0 and 1.")
        task["progress"] = args.progress
        changed = True

    if not changed:
        die("No updates provided. Use at least one of --status/--verdict/--progress.")

    task["updatedAt"] = now_iso()
    write_json(task_file, task)
    success(f"✅ Updated task {args.id}")


def cmd_task_history(args):
    if args.action not in TASK_ACTIONS:
        die(f"Invalid action '{args.action}'. Allowed: {sorted(TASK_ACTIONS)}")

    root = require_mesh_root()
    paths = mesh_paths(root)
    task_file, task = load_task(paths, args.id)

    agent = args.agent or task.get("assignedTo") or "unknown"
    entry = {
        "agent": agent,
        "action": args.action,
        "summary": args.summary,
        "at": now_iso(),
    }
    if args.ref:
        entry["ref"] = args.ref

    history = task.get("history")
    if not isinstance(history, list):
        history = []
    history.append(entry)
    task["history"] = history
    task["updatedAt"] = now_iso()

    write_json(task_file, task)
    success(f"✅ Added history entry to {args.id}")


def cmd_task_list(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    files = collect_task_files(paths, include_archived=False)

    rows = []
    for file in files:
        task = read_json(file)
        if args.status and task.get("status") != args.status:
            continue
        if args.agent and task.get("assignedTo") != args.agent:
            continue
        if args.type and task.get("type") != args.type:
            continue
        rows.append(task)

    if not rows:
        warn("📋 No matching tasks.")
        return

    for task in rows:
        icon = "✅" if task.get("status") in {"merged", "closed", "deployed"} else ("🚫" if task.get("status") == "blocked" else "⏳")
        print(
            f"{icon} {task.get('id')} | {task.get('status')} | {task.get('type')} | {task.get('assignedTo')} | verdict={task.get('verdict', '-')} | progress={task.get('progress', 0)}"
        )


def cmd_task_archive(args):
    root = require_mesh_root()
    paths = mesh_paths(root)

    src = paths["active"] / f"{args.id}.json"
    dst = paths["archived"] / f"{args.id}.json"
    if not src.exists():
        die(f"Task '{args.id}' not found in active tasks.")
    if dst.exists():
        die(f"Task '{args.id}' is already archived.")

    task = read_json(src)
    task["status"] = "archived"
    task["updatedAt"] = now_iso()
    write_json(src, task)
    src.rename(dst)
    success(f"✅ Archived task {args.id}")


def resolve_shared_file(paths, value):
    name = value.strip()
    allowed = {"context", "decisions", "blockers", "context.md", "decisions.md", "blockers.md"}
    if name not in allowed:
        die("Shared file must be one of: context, decisions, blockers")
    if not name.endswith(".md"):
        name += ".md"
    return paths["shared"] / name


def cmd_shared_read(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    p = resolve_shared_file(paths, args.file)
    if not p.exists():
        die(f"Shared file does not exist: {p.name}")
    print(read_text(p), end="")


def cmd_shared_append(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    p = resolve_shared_file(paths, args.file)
    stamp = now_iso()
    content = args.content.rstrip("\n")
    block = f"\n## [{stamp}]\n{content}\n"
    append_text(p, block)
    success(f"✅ Appended to {p.name}")


def cmd_shared_update(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    p = resolve_shared_file(paths, args.file)
    content = args.content.rstrip("\n") + "\n"
    write_text(p, content)
    success(f"✅ Replaced {p.name}")


def cmd_task_assign(args):
    if not is_agent_name(args.agent):
        die("Invalid agent name. Use lowercase letters, digits, and hyphens.")
    root = require_mesh_root()
    paths = mesh_paths(root)
    task_file, task = load_task(paths, args.id)
    old = task.get("assignedTo", "unassigned")
    task["assignedTo"] = args.agent
    task["updatedAt"] = now_iso()
    history = task.get("history", [])
    history.append({
        "agent": args.agent,
        "action": "commented",
        "summary": f"Reassigned from {old} to {args.agent}",
        "at": now_iso(),
    })
    task["history"] = history
    write_json(task_file, task)
    success(f"✅ Reassigned {args.id}: {old} → {args.agent}")


def cmd_task_search(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    files = collect_task_files(paths, include_archived=args.archived)
    query = args.query.lower()
    hits = []
    for f in files:
        task = read_json(f)
        searchable = " ".join([
            task.get("title", ""),
            task.get("id", ""),
            task.get("assignedTo", ""),
            task.get("type", ""),
            task.get("status", ""),
        ]).lower()
        # Also search history summaries
        for h in task.get("history", []):
            searchable += " " + h.get("summary", "").lower()
        if query in searchable:
            hits.append(task)
    if not hits:
        warn(f"No tasks matching '{args.query}'")
        return
    for task in hits:
        icon = "✅" if task.get("status") in {"merged", "closed", "deployed"} else "⏳"
        print(f"{icon} {task.get('id')} | {task.get('status')} | {task.get('title')}")


def cmd_pulse_clean(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    now = datetime.datetime.now(datetime.timezone.utc)
    threshold = datetime.timedelta(minutes=args.stale_minutes)
    removed = 0
    for pf in collect_pulse_files(paths):
        data = read_json(pf)
        ts = parse_iso(data.get("lastUpdate"))
        if ts is None:
            continue
        age = now - ts.astimezone(datetime.timezone.utc)
        if age > threshold:
            agent = data.get("agent", pf.stem)
            status = data.get("status", "unknown")
            if status in {"done", "idle"}:
                pf.unlink()
                removed += 1
                info(f"  🗑️  Removed stale pulse: {agent} (last update {int(age.total_seconds() // 60)}m ago)")
            else:
                warn(f"  ⚠️  Skipped {agent}: status={status}, stale {int(age.total_seconds() // 60)}m (not done/idle)")
    success(f"\n✅ Cleaned {removed} stale pulse(s)")


def cmd_export(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    lines = ["# Agent Mesh Status Report", "", f"Generated: {now_iso()}", ""]

    # Agents
    lines.append("## 📡 Agents")
    pulse_files = collect_pulse_files(paths)
    if not pulse_files:
        lines.append("(none)")
    for pf in pulse_files:
        data = read_json(pf)
        status = data.get("status", "unknown")
        agent = data.get("agent", pf.stem)
        task_id = (data.get("currentTask") or {}).get("id", "-")
        summary = ""
        recent = data.get("recentActions") or []
        if recent and isinstance(recent, list) and recent:
            last = recent[-1]
            if isinstance(last, dict) and last.get("summary"):
                summary = f" — {last['summary']}"
        lines.append(f"- **{agent}**: {status} | task: {task_id}{summary}")
    lines.append("")

    # Active tasks
    lines.append("## 📋 Active Tasks")
    task_files = collect_task_files(paths, include_archived=False)
    if not task_files:
        lines.append("(none)")
    for tf in task_files:
        task = read_json(tf)
        lines.append(
            f"- **{task.get('id')}** [{task.get('status')}] verdict={task.get('verdict', '-')} "
            f"assignee={task.get('assignedTo', '-')} — {task.get('title', '')}"
        )
    lines.append("")

    # Blockers
    blockers_path = paths["shared"] / "blockers.md"
    if blockers_path.exists():
        content = read_text(blockers_path).strip()
        if content and content != "# Blockers\n\nTrack blockers that need human input or cross-agent coordination.":
            lines.append("## 🚫 Blockers")
            lines.append(content)
            lines.append("")

    output = "\n".join(lines)
    if args.output:
        write_text(Path(args.output), output)
        success(f"✅ Exported to {args.output}")
    else:
        print(output)


def cmd_validate(_args):
    root = require_mesh_root()
    paths = mesh_paths(root)

    project_root = Path(__file__).resolve().parent.parent
    pulse_schema = read_json(project_root / "schema" / "pulse-v1.json")
    task_schema = read_json(project_root / "schema" / "task-v1.json")

    any_error = False

    pulse_files = collect_pulse_files(paths)
    task_files = collect_task_files(paths, include_archived=True)

    for pf in pulse_files:
        data = read_json(pf)
        errs = validate_by_schema(data, pulse_schema)
        if errs:
            any_error = True
            fail(f"❌ {pf}")
            for e in errs:
                print(f"   - {e}")

    for tf in task_files:
        data = read_json(tf)
        errs = validate_by_schema(data, task_schema)
        if errs:
            any_error = True
            fail(f"❌ {tf}")
            for e in errs:
                print(f"   - {e}")

    if any_error:
        raise SystemExit(1)

    success("✅ Validation passed")


def gh_json(args_str):
    """Run gh CLI and return parsed JSON, or None on failure."""
    import subprocess
    try:
        r = subprocess.run(
            f"gh {args_str}",
            shell=True, capture_output=True, text=True, timeout=30,
        )
        if r.returncode != 0:
            warn(f"gh failed: {r.stderr.strip()}")
            return None
        return json.loads(r.stdout)
    except (json.JSONDecodeError, subprocess.TimeoutExpired, FileNotFoundError) as e:
        warn(f"gh error: {e}")
        return None


def gh_pr_to_mesh_status(ci_status, is_merged, is_draft, review_decision):
    """Map GitHub PR state to mesh task status."""
    if is_merged:
        return "merged"
    if ci_status == "FAILURE":
        return "ci-fail"
    if ci_status == "SUCCESS":
        return "ci-pass"
    if review_decision == "APPROVED":
        return "review"
    if is_draft:
        return "open"
    return "in-progress"


def gh_estimate_progress(ci_status, review_decision):
    """Estimate progress from CI + review state."""
    p = 0.3
    if ci_status == "SUCCESS":
        p += 0.4
    elif ci_status == "FAILURE":
        p += 0.1
    if review_decision == "APPROVED":
        p += 0.2
    elif review_decision == "CHANGES_REQUESTED":
        p += 0.05
    return round(min(p, 1.0), 2)


def cmd_sync(args):
    # Check gh CLI availability
    import subprocess
    try:
        r = subprocess.run("gh --version", shell=True, capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            die("GitHub CLI (gh) not found. Install: https://cli.github.com")
    except FileNotFoundError:
        die("GitHub CLI (gh) not found. Install: https://cli.github.com")
    # Check gh auth
    r = subprocess.run("gh auth status", shell=True, capture_output=True, text=True, timeout=10)
    if r.returncode != 0:
        die("gh not authenticated. Run: gh auth login")

    repo = args.repo
    if not repo:
        try:
            r = subprocess.run(
                "gh repo view --json nameWithOwner -q .nameWithOwner",
                shell=True, capture_output=True, text=True, timeout=10,
            )
            if r.returncode == 0 and r.stdout.strip():
                repo = r.stdout.strip()
        except Exception:
            pass
    if not repo:
        die("Could not detect repo. Use --repo owner/name.")

    info(f"📡 Syncing from {repo}...")

    # Fetch open PRs
    prs = gh_json(
        f"pr list --repo {repo} --state open --limit 100 "
        "--json number,title,state,isDraft,reviewDecision,statusCheckRollup,author,headRefName"
    )
    if prs is None:
        die("Failed to fetch PRs from GitHub.")

    # Fetch recently merged PRs (last 7 days)
    merged_prs = gh_json(
        f"pr list --repo {repo} --state merged --limit 50 "
        "--json number,title,state,mergedAt,author"
    )
    if merged_prs is None:
        merged_prs = []

    root = require_mesh_root()
    paths = mesh_paths(root)

    # Load existing tasks
    existing = {}
    for f in collect_task_files(paths, include_archived=False):
        task = read_json(f)
        existing[task.get("id", f.stem)] = task

    created, updated, unchanged = 0, 0, 0
    now = now_iso()

    # Process open PRs
    for pr in prs:
        num = pr["number"]
        task_id = f"pr-{num}"
        title = pr.get("title", f"PR #{num}")

        # Determine CI status from check rollup
        checks = pr.get("statusCheckRollup") or []
        ci_status = "PENDING"
        if checks:
            conclusions = [c.get("conclusion") or c.get("status") for c in checks]
            if "FAILURE" in conclusions:
                ci_status = "FAILURE"
            elif all(s == "SUCCESS" for s in conclusions):
                ci_status = "SUCCESS"

        is_merged = pr.get("state") == "MERGED"
        is_draft = pr.get("isDraft", False)
        review_decision = pr.get("reviewDecision") or "pending"

        mesh_status = gh_pr_to_mesh_status(ci_status, is_merged, is_draft, review_decision)
        progress = gh_estimate_progress(ci_status, review_decision)

        if task_id in existing:
            task = existing[task_id]
            old_status = task.get("status")
            if old_status != mesh_status:
                task["status"] = mesh_status
                task["progress"] = progress
                task["updatedAt"] = now
                history = task.get("history", [])
                history.append({
                    "agent": "mesh-sync",
                    "action": "validated",
                    "summary": f"GitHub sync: {old_status} → {mesh_status} (CI: {ci_status}, review: {review_decision})",
                    "at": now,
                })
                task["history"] = history
                write_json(paths["active"] / f"{task_id}.json", task)
                updated += 1
                info(f"  📝 {task_id}: {old_status} → {mesh_status}")
            else:
                unchanged += 1
        else:
            # New task from GitHub
            task = {
                "schema": TASK_SCHEMA_ID,
                "id": task_id,
                "type": "upstream-pr",
                "title": title,
                "status": mesh_status,
                "verdict": "pending",
                "priority": "medium",
                "assignedTo": pr.get("author", {}).get("login", "unknown"),
                "createdAt": now,
                "updatedAt": now,
                "progress": progress,
                "links": {
                    "github": f"https://github.com/{repo}/pull/{num}",
                },
                "history": [{
                    "agent": "mesh-sync",
                    "action": "created",
                    "summary": f"Auto-discovered from GitHub: {title}",
                    "at": now,
                }],
            }
            write_json(paths["active"] / f"{task_id}.json", task)
            created += 1
            info(f"  ✨ {task_id}: {mesh_status} — {title}")

    # Process merged PRs → mark existing tasks as merged
    for pr in merged_prs:
        num = pr["number"]
        task_id = f"pr-{num}"
        if task_id in existing:
            task = existing[task_id]
            if task.get("status") != "merged":
                old_status = task["status"]
                task["status"] = "merged"
                task["progress"] = 1.0
                task["updatedAt"] = now
                history = task.get("history", [])
                history.append({
                    "agent": "mesh-sync",
                    "action": "merged",
                    "summary": "PR merged on GitHub",
                    "at": now,
                })
                task["history"] = history
                write_json(paths["active"] / f"{task_id}.json", task)
                updated += 1
                info(f"  🔀 {task_id}: {old_status} → merged")

    success(f"\n✅ Sync complete: {created} created, {updated} updated, {unchanged} unchanged")


def build_parser():
    parser = argparse.ArgumentParser(prog="mesh", description="Agent Mesh CLI")
    sub = parser.add_subparsers(dest="command")

    p_init = sub.add_parser("init", help="Initialize .mesh directory")
    p_init.set_defaults(func=cmd_init)

    p_status = sub.add_parser("status", help="Show mesh status overview")
    p_status.set_defaults(func=cmd_status)

    p_pulse = sub.add_parser("pulse", help="Pulse operations")
    pulse_sub = p_pulse.add_subparsers(dest="pulse_command")

    p_pulse_read = pulse_sub.add_parser("read", help="Read pulse files")
    p_pulse_read.add_argument("--agent", help="Agent name")
    p_pulse_read.add_argument("--all", action="store_true", help="Read all agents")
    p_pulse_read.set_defaults(func=cmd_pulse_read)

    p_pulse_update = pulse_sub.add_parser("update", help="Create or update an agent pulse")
    p_pulse_update.add_argument("--agent", required=True, help="Agent name")
    p_pulse_update.add_argument("--status", required=True, help="Pulse status")
    p_pulse_update.add_argument("--task", help="Current task ID")
    p_pulse_update.add_argument("--summary", help="Recent action summary")
    p_pulse_update.set_defaults(func=cmd_pulse_update)

    p_pulse_check = pulse_sub.add_parser("check", help="Find stale pulses (>30m)")
    p_pulse_check.set_defaults(func=cmd_pulse_check)

    p_pulse_clean = pulse_sub.add_parser("clean", help="Remove stale done/idle pulses")
    p_pulse_clean.add_argument("--stale-minutes", type=int, default=60, help="Stale threshold in minutes (default: 60)")
    p_pulse_clean.set_defaults(func=cmd_pulse_clean)

    p_task = sub.add_parser("task", help="Task operations")
    task_sub = p_task.add_subparsers(dest="task_command")

    p_task_create = task_sub.add_parser("create", help="Create a task")
    p_task_create.add_argument("--id", required=True, help="Task ID")
    p_task_create.add_argument("--title", required=True, help="Task title")
    p_task_create.add_argument("--type", required=True, help="Task type")
    p_task_create.add_argument("--assign", help="Assign to agent")
    p_task_create.add_argument("--priority", default="medium", help="Priority")
    p_task_create.set_defaults(func=cmd_task_create)

    p_task_update = task_sub.add_parser("update", help="Update task fields")
    p_task_update.add_argument("--id", required=True, help="Task ID")
    p_task_update.add_argument("--status", help="Task status")
    p_task_update.add_argument("--verdict", help="Task verdict")
    p_task_update.add_argument("--progress", type=float, help="Progress (0-1)")
    p_task_update.set_defaults(func=cmd_task_update)

    p_task_history = task_sub.add_parser("history", help="Append task history")
    p_task_history.add_argument("--id", required=True, help="Task ID")
    p_task_history.add_argument("--action", required=True, help="History action")
    p_task_history.add_argument("--summary", required=True, help="History summary")
    p_task_history.add_argument("--agent", help="Agent name")
    p_task_history.add_argument("--ref", help="Optional reference")
    p_task_history.set_defaults(func=cmd_task_history)

    p_task_list = task_sub.add_parser("list", help="List tasks")
    p_task_list.add_argument("--status", help="Filter by status")
    p_task_list.add_argument("--agent", help="Filter by assignee")
    p_task_list.add_argument("--type", help="Filter by task type")
    p_task_list.set_defaults(func=cmd_task_list)

    p_task_archive = task_sub.add_parser("archive", help="Archive a task")
    p_task_archive.add_argument("--id", required=True, help="Task ID")
    p_task_archive.set_defaults(func=cmd_task_archive)

    p_task_assign = task_sub.add_parser("assign", help="Reassign a task")
    p_task_assign.add_argument("--id", required=True, help="Task ID")
    p_task_assign.add_argument("--agent", required=True, help="New assignee")
    p_task_assign.set_defaults(func=cmd_task_assign)

    p_task_search = task_sub.add_parser("search", help="Search tasks by keyword")
    p_task_search.add_argument("query", help="Search query")
    p_task_search.add_argument("--archived", action="store_true", help="Include archived tasks")
    p_task_search.set_defaults(func=cmd_task_search)

    p_shared = sub.add_parser("shared", help="Shared knowledge files")
    shared_sub = p_shared.add_subparsers(dest="shared_command")

    p_shared_read = shared_sub.add_parser("read", help="Read shared file")
    p_shared_read.add_argument("file", help="context|decisions|blockers")
    p_shared_read.set_defaults(func=cmd_shared_read)

    p_shared_append = shared_sub.add_parser("append", help="Append to shared file")
    p_shared_append.add_argument("file", help="context|decisions|blockers")
    p_shared_append.add_argument("--content", required=True, help="Content to append")
    p_shared_append.set_defaults(func=cmd_shared_append)

    p_shared_update = shared_sub.add_parser("update", help="Replace shared file content")
    p_shared_update.add_argument("file", help="context|decisions|blockers")
    p_shared_update.add_argument("--content", required=True, help="New content")
    p_shared_update.set_defaults(func=cmd_shared_update)

    p_validate = sub.add_parser("validate", help="Validate all pulse/task JSON files")
    p_validate.set_defaults(func=cmd_validate)

    p_sync = sub.add_parser("sync", help="Sync PR status from GitHub")
    p_sync.add_argument("--repo", help="GitHub repo (owner/name). Auto-detects from git remote if omitted.")
    p_sync.set_defaults(func=cmd_sync)

    p_export = sub.add_parser("export", help="Export status as markdown")
    p_export.add_argument("--output", "-o", help="Output file (default: stdout)")
    p_export.set_defaults(func=cmd_export)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    func = getattr(args, "func", None)
    if func is None:
        parser.print_help()
        raise SystemExit(1)

    func(args)


if __name__ == "__main__":
    main()
