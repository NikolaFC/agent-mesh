def load_mesh_config(root):
    """Load .mesh/config.json, return defaults if missing."""
    config_path = root / ".mesh" / "config.json"
    defaults = {
        "evolution": {
            "autoRotate": True,
            "rotateThreshold": 200,
            "rotateKeep": 30,
            "index": {
                "enabled": True,
                "experimental": True,
                "format": "jsonl",
                "path": ".mesh/shared/evolution/index.jsonl",
                "autoIndex": True,
            },
        },
        "tasks": {
            "index": {
                "enabled": True,
                "experimental": True,
                "format": "jsonl",
                "path": ".mesh/tasks/index.jsonl",
                "autoIndex": True,
            },
        },
        "pulses": {
            "index": {
                "enabled": True,
                "experimental": True,
                "format": "jsonl",
                "path": ".mesh/pulse/index.jsonl",
                "autoIndex": True,
            },
        },
        "stateSync": {
            "backend": "git",
            "remote": "",
            "branch": "main",
            "path": ".mesh",
            "ignoreGenerated": True,
        },
    }
    if not config_path.exists():
        return defaults
    try:
        with config_path.open("r", encoding="utf-8") as f:
            user = json.load(f)
        def merge(base, override):
            for k, v in override.items():
                if k in base and isinstance(base[k], dict) and isinstance(v, dict):
                    merge(base[k], v)
                else:
                    base[k] = v
        merge(defaults, user)
        return defaults
    except (json.JSONDecodeError, OSError) as e:
        warn(f"Failed to read config.json: {e}, using defaults")
        return defaults


def save_mesh_config(root, config):
    """Persist mesh configuration."""
    write_json(root / ".mesh" / "config.json", config)


def rebuild_indexes(root, paths):
    """Rebuild all enabled indexes (tasks, pulses, evolution)."""
    config = load_mesh_config(root)
    now = now_iso()

    # Tasks index
    t_cfg = config.get("tasks", {}).get("index", {})
    if t_cfg.get("enabled") and t_cfg.get("autoIndex"):
        idx_path = root / t_cfg.get("path", ".mesh/tasks/index.jsonl")
        idx_path.parent.mkdir(parents=True, exist_ok=True)
        entries = []
        for f in collect_task_files(paths, include_archived=True):
            t = read_json(f)
            last_history = t.get("history", [{}])[-1] if t.get("history") else {}
            entries.append({
                "id": t.get("id"),
                "type": t.get("type"),
                "title": t.get("title", "")[:200],
                "status": t.get("status"),
                "verdict": t.get("verdict"),
                "priority": t.get("priority"),
                "assignedTo": t.get("assignedTo"),
                "progress": t.get("progress", 0),
                "updatedAt": t.get("updatedAt"),
                "lastAction": last_history.get("action"),
                "lastSummary": last_history.get("summary", "")[:200],
            })
        with idx_path.open("w", encoding="utf-8") as out:
            for e in entries:
                out.write(json.dumps(e, ensure_ascii=False) + "\n")

    # Pulses index
    p_cfg = config.get("pulses", {}).get("index", {})
    if p_cfg.get("enabled") and p_cfg.get("autoIndex"):
        idx_path = root / p_cfg.get("path", ".mesh/pulse/index.jsonl")
        idx_path.parent.mkdir(parents=True, exist_ok=True)
        entries = []
        for f in collect_pulse_files(paths):
            p = read_json(f)
            last_action = p.get("recentActions", [{}])[-1] if p.get("recentActions") else {}
            entries.append({
                "agent": p.get("agent"),
                "status": p.get("status"),
                "currentTask": (p.get("currentTask") or {}).get("id"),
                "lastUpdate": p.get("lastUpdate"),
                "lastSummary": last_action.get("summary", "")[:200],
            })
        with idx_path.open("w", encoding="utf-8") as out:
            for e in entries:
                out.write(json.dumps(e, ensure_ascii=False) + "\n")


def cmd_index(_args):
    """Manually rebuild all indexes."""
    root = require_mesh_root()
    paths = mesh_paths(root)
    rebuild_indexes(root, paths)
    # Also rebuild evolution index
    config = load_mesh_config(root)
    evo_cfg = config.get("evolution", {}).get("index", {})
    if evo_cfg.get("enabled"):
        evo_files = collect_evolution_files(paths)
        idx_path = root / evo_cfg.get("path", ".mesh/shared/evolution/index.jsonl")
        idx_path.parent.mkdir(parents=True, exist_ok=True)
        entries = []
        for f in evo_files:
            agent = f.stem
            content = read_text(f)
            for chunk in content.split("\n## ["):
                if "]" not in chunk:
                    continue
                ts_rest = chunk.split("]", 1)
                ts_str = ts_rest[0].strip()
                rest = ts_rest[1].strip() if len(ts_rest) > 1 else ""
                cat = ""
                fc = ""
                if " — " in rest:
                    hp, sm = rest.split("\n", 1) if "\n" in rest else (rest, "")
                    ps = hp.split(" — ", 1)
                    cat = ps[0].strip()
                    fc = ps[1].strip() if len(ps) > 1 else ""
                else:
                    sm = rest
                entries.append({"agent": agent, "timestamp": ts_str, "category": cat, "file": fc, "summary": sm.strip()[:500]})
        with idx_path.open("w", encoding="utf-8") as out:
            for e in entries:
                out.write(json.dumps(e, ensure_ascii=False) + "\n")
    success("✅ All indexes rebuilt")


