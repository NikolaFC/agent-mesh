def ensure_mcp_structure(root):
    paths = mcp_paths(root)
    for key in ("mcp", "sessions", "requests", "grants"):
        paths[key].mkdir(parents=True, exist_ok=True)
    if not paths["servers"].exists():
        write_json(paths["servers"], {"schema": "agent-mesh/mcp-servers/v1", "servers": {}})


def safe_storage_id(value):
    text = str(value or "")
    slug = re.sub(r"[^a-zA-Z0-9_.:-]+", "-", text).strip("-._:")[:80]
    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]
    return f"{slug or 'item'}-{digest}"


def mcp_session_key(agent, session_id):
    return f"{agent}:{session_id}"


def parse_mcp_session_key(key):
    if ":" not in key:
        return None, key
    agent, session_id = key.split(":", 1)
    return agent, session_id


def is_mcp_shared_agent_supported(agent):
    return str(agent or "").strip().lower() in MCP_SHARED_AGENT_ALLOWLIST


def normalize_mcp_shared_agent(agent, label="agent"):
    value = str(agent or "").strip().lower()
    if not value:
        die(f"{label} is required")
    if not re.fullmatch(r"[a-z0-9-]+", value):
        die(f"{label} must be lowercase alphanumeric plus hyphen")
    if value not in MCP_SHARED_AGENT_ALLOWLIST:
        die(
            "Experimental shared MCP currently supports only OpenClaw/Hermes "
            f"agents ({MCP_SHARED_AGENT_ALLOWLIST_TEXT}); got {agent!r}"
        )
    return value


def is_mcp_shared_session_supported(session):
    agent = session.get("agent") if isinstance(session, dict) else None
    if not agent and isinstance(session, dict):
        agent = parse_mcp_session_key(session.get("key", ""))[0]
    return is_mcp_shared_agent_supported(agent)


def mcp_session_path(root, key):
    return mcp_paths(root)["sessions"] / f"{safe_storage_id(key)}.json"


def load_mcp_sessions(root):
    sessions_dir = mcp_paths(root)["sessions"]
    if not sessions_dir.exists():
        return []
    sessions = []
    for path in sorted(sessions_dir.glob("*.json")):
        try:
            data = read_json(path)
            data["_path"] = str(path)
            sessions.append(data)
        except SystemExit:
            raise
        except Exception:
            continue
    return sessions


def find_mcp_session(root, key):
    direct = mcp_session_path(root, key)
    if direct.exists():
        return read_json(direct)
    for item in load_mcp_sessions(root):
        if item.get("key") == key:
            return item
    die(f"Unknown MCP session: {key}")


def append_mcp_audit(root, event):
    ensure_mcp_structure(root)
    event = {"at": now_iso(), **event}
    audit_path = mcp_paths(root)["audit"]
    append_text(audit_path, json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")


def load_mcp_servers(root):
    ensure_mcp_structure(root)
    path = mcp_paths(root)["servers"]
    data = read_json(path)
    if "servers" not in data or not isinstance(data["servers"], dict):
        data = {"schema": "agent-mesh/mcp-servers/v1", "servers": {}}
    return data


def write_mcp_servers(root, data):
    ensure_mcp_structure(root)
    data.setdefault("schema", "agent-mesh/mcp-servers/v1")
    data.setdefault("servers", {})
    write_json(mcp_paths(root)["servers"], data)


def mcp_request_path(root, request_id):
    return mcp_paths(root)["requests"] / f"{safe_storage_id(request_id)}.json"


def mcp_grant_path(root, grant_id):
    return mcp_paths(root)["grants"] / f"{safe_storage_id(grant_id)}.json"


def create_mcp_access_request(root, requesting_agent, target_session, reason, scope="full", current_session=None):
    ensure_mcp_structure(root)
    requesting_agent = normalize_mcp_shared_agent(requesting_agent, "--requesting-agent")
    if not target_session:
        die("--target-session is required")
    session = find_mcp_session(root, target_session)
    target_agent = session.get("agent") or parse_mcp_session_key(target_session)[0]
    normalize_mcp_shared_agent(target_agent, "target session agent")
    request_id = safe_storage_id(f"{now_iso()}:{requesting_agent}:{target_session}:{reason}")
    data = {
        "schema": "agent-mesh/mcp-access-request/v1",
        "id": request_id,
        "status": "pending",
        "requestingAgent": requesting_agent,
        "currentSession": current_session,
        "targetSession": target_session,
        "scope": scope,
        "reason": reason or "unspecified",
        "createdAt": now_iso(),
        "updatedAt": now_iso(),
    }
    write_json(mcp_request_path(root, request_id), data)
    append_mcp_audit(root, {
        "event": "access_requested",
        "requestId": request_id,
        "requestingAgent": requesting_agent,
        "targetSession": target_session,
        "scope": scope,
        "reason": reason or "unspecified",
    })
    return data


def load_mcp_request(root, request_id):
    path = mcp_request_path(root, request_id)
    if path.exists():
        return read_json(path), path
    req_dir = mcp_paths(root)["requests"]
    if req_dir.exists():
        for path in req_dir.glob("*.json"):
            data = read_json(path)
            if data.get("id") == request_id:
                return data, path
    die(f"Unknown MCP access request: {request_id}")


def decide_mcp_access_request(root, request_id, decision, decided_by, current_session=None):
    ensure_mcp_structure(root)
    if decision not in {"allow-once", "allow-session", "deny"}:
        die("Decision must be allow-once, allow-session, or deny")
    request, path = load_mcp_request(root, request_id)
    request["decision"] = decision
    request["decidedBy"] = decided_by or "unknown"
    request["decidedAt"] = now_iso()
    request["updatedAt"] = now_iso()
    grant = None
    if decision == "deny":
        request["status"] = "denied"
    else:
        request["status"] = "allowed"
        grant_id = safe_storage_id(f"grant:{request_id}:{decision}:{now_iso()}")
        grant = {
            "schema": "agent-mesh/mcp-access-grant/v1",
            "id": grant_id,
            "status": "active",
            "grantType": decision,
            "requestId": request_id,
            "requestingAgent": request.get("requestingAgent"),
            "currentSession": current_session if decision == "allow-session" else request.get("currentSession"),
            "targetSession": request.get("targetSession"),
            "scope": request.get("scope", "full"),
            "remainingReads": 1 if decision == "allow-once" else None,
            "createdAt": now_iso(),
            "createdBy": decided_by or "unknown",
        }
        write_json(mcp_grant_path(root, grant_id), grant)
        request["grantId"] = grant_id
    write_json(path, request)
    append_mcp_audit(root, {
        "event": "access_decided",
        "requestId": request_id,
        "decision": decision,
        "decidedBy": decided_by or "unknown",
        "grantId": grant.get("id") if grant else None,
    })
    return {"request": request, "grant": grant}


def find_active_mcp_grant(root, requesting_agent, target_session, current_session=None):
    grants_dir = mcp_paths(root)["grants"]
    if not grants_dir.exists():
        return None, None
    for path in sorted(grants_dir.glob("*.json")):
        data = read_json(path)
        if data.get("status") != "active":
            continue
        if data.get("requestingAgent") != requesting_agent:
            continue
        if data.get("targetSession") != target_session:
            continue
        grant_type = data.get("grantType")
        if grant_type == "allow-once":
            if data.get("remainingReads", 0) and data.get("remainingReads", 0) > 0:
                return data, path
        elif grant_type == "allow-session":
            grant_session = data.get("currentSession")
            if not grant_session or not current_session or grant_session == current_session:
                return data, path
    return None, None


def consume_mcp_grant_if_needed(grant, path):
    if not grant or not path:
        return
    if grant.get("grantType") == "allow-once":
        remaining = int(grant.get("remainingReads") or 0) - 1
        grant["remainingReads"] = max(0, remaining)
        if grant["remainingReads"] <= 0:
            grant["status"] = "consumed"
            grant["consumedAt"] = now_iso()
        grant["updatedAt"] = now_iso()
        write_json(path, grant)


def extract_transcript_block_text(block):
    if block is None:
        return ""
    if isinstance(block, str):
        return block
    if isinstance(block, list):
        return "\n".join(part for part in (extract_transcript_block_text(item) for item in block) if part)
    if not isinstance(block, dict):
        return str(block)
    btype = block.get("type")
    if isinstance(block.get("text"), str):
        return block["text"]
    if isinstance(block.get("thinking"), str) and block["thinking"].strip():
        return f"[thinking] {block['thinking']}"
    if btype == "toolCall" or "arguments" in block:
        name = block.get("name") or block.get("toolName") or "tool"
        args = block.get("arguments")
        if args is None:
            return f"[toolCall] {name}"
        if not isinstance(args, str):
            args = json.dumps(args, ensure_ascii=False)
        return f"[toolCall] {name}: {args}"
    if btype == "toolResult" or "toolName" in block:
        name = block.get("toolName") or block.get("name") or "tool"
        content = extract_transcript_block_text(block.get("content"))
        return f"[toolResult] {name}: {content}" if content else f"[toolResult] {name}"
    if "content" in block:
        return extract_transcript_block_text(block.get("content"))
    # Do not dump unknown blocks wholesale: OpenClaw/Codex transcript blocks may
    # contain encrypted reasoning signatures. Those are not useful handoff text.
    return ""


def extract_transcript_entry_text(item):
    if not isinstance(item, dict):
        return str(item)
    if isinstance(item.get("message"), dict):
        msg = item["message"]
        role = msg.get("role") or item.get("role") or item.get("type") or "entry"
        body = extract_transcript_block_text(msg.get("content"))
        return f"{role}: {body}" if body else ""
    role = item.get("role") or item.get("customType") or item.get("type") or "entry"
    body = extract_transcript_block_text(item.get("content")) or extract_transcript_block_text(item.get("text"))
    if body:
        return f"{role}: {body}"
    return ""


def compact_transcript_for_budget(text, token_budget):
    # Context packs should be useful handoff material, not a random slice through
    # one giant tool payload. Keep the latest lines but first cap pathological
    # lines so a single JSON/tool result cannot consume the whole budget.
    char_budget = max(500, int(token_budget) * 4)
    max_entry = max(500, min(2500, char_budget // 3))
    entries = text.split("\n\n") if "\n\n" in text else text.splitlines()
    compacted = []
    for entry in entries:
        if len(entry) > max_entry:
            head = max_entry // 2
            tail = max_entry - head
            entry = f"{entry[:head]} …[truncated {len(entry) - max_entry} chars]… {entry[-tail:]}"
        compacted.append(entry)
    selected = []
    total = 0
    for entry in reversed(compacted):
        extra = len(entry) + (2 if selected else 0)
        if selected and total + extra > char_budget:
            break
        if not selected and extra > char_budget:
            entry = entry[-char_budget:]
            extra = len(entry)
        selected.append(entry)
        total += extra
    selected.reverse()
    out = "\n\n".join(selected)
    if len(compacted) > len(selected):
        out = "[earlier transcript omitted to fit context budget]\n" + out
    return out


def read_transcript_content(session, mode="full", limit=None, token_budget=None):
    transcript_path = Path(session.get("transcriptPath", "")).expanduser()
    if not transcript_path.is_absolute():
        transcript_path = (Path(os.getcwd()) / transcript_path).resolve()
    if not transcript_path.exists():
        die(f"Transcript path does not exist: {transcript_path}")
    text = read_text(transcript_path)
    fmt = session.get("transcriptFormat", "text")
    if fmt == "jsonl":
        lines = []
        for raw in text.splitlines():
            if not raw.strip():
                continue
            try:
                item = json.loads(raw)
                line = extract_transcript_entry_text(item)
                if line:
                    lines.append(line)
            except json.JSONDecodeError:
                lines.append(raw)
        text = "\n\n".join(lines)
    if mode == "recent":
        n = int(limit or 80)
        text = "\n".join(text.splitlines()[-n:])
    elif mode == "summary":
        lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
        head = lines[:12]
        tail = lines[-12:] if len(lines) > 12 else []
        text = "\n".join(head + (["..."] if tail and head != tail else []) + tail)
    if token_budget:
        text = compact_transcript_for_budget(text, token_budget)
    return text


def read_mcp_transcript_authorized(root, requesting_agent, target_session, mode="full", current_session=None, reason=None, limit=None, token_budget=None, auto_request=False):
    requesting_agent = normalize_mcp_shared_agent(requesting_agent, "requestingAgent")
    session = find_mcp_session(root, target_session)
    target_agent = session.get("agent") or parse_mcp_session_key(target_session)[0]
    target_agent = normalize_mcp_shared_agent(target_agent, "target session agent")
    grant = grant_path = None
    if target_agent and requesting_agent != target_agent:
        grant, grant_path = find_active_mcp_grant(root, requesting_agent, target_session, current_session)
        if not grant:
            if auto_request:
                req = create_mcp_access_request(root, requesting_agent, target_session, reason or "cross-agent transcript read", mode, current_session)
                return {"requiresApproval": True, "requestId": req["id"], "targetSession": target_session}
            die(f"Cross-agent transcript read requires approval for {requesting_agent} -> {target_session}")
    content = read_transcript_content(session, mode=mode, limit=limit, token_budget=token_budget)
    consume_mcp_grant_if_needed(grant, grant_path)
    append_mcp_audit(root, {
        "event": "transcript_read",
        "requestingAgent": requesting_agent,
        "targetSession": target_session,
        "targetAgent": target_agent,
        "mode": mode,
        "currentSession": current_session,
        "reason": reason,
        "grantId": grant.get("id") if grant else None,
        "chars": len(content),
    })
    return {"requiresApproval": False, "session": session, "content": content, "chars": len(content)}


def make_mcp_context_pack(root, requesting_agent, target_session, current_session=None, token_budget=4000, reason=None, auto_request=False):
    result = read_mcp_transcript_authorized(
        root,
        requesting_agent=requesting_agent,
        target_session=target_session,
        mode="full",
        current_session=current_session,
        reason=reason or "context pack",
        token_budget=token_budget,
        auto_request=auto_request,
    )
    if result.get("requiresApproval"):
        return result
    session = result["session"]
    content = result["content"]
    pack = (
        f"# Mesh Context Pack\n\n"
        f"Source session: {session.get('key')}\n"
        f"Source agent: {session.get('agent')}\n"
        f"Title: {session.get('title') or ''}\n"
        f"Generated: {now_iso()}\n"
        f"Reason: {reason or 'context handoff'}\n\n"
        f"## Transcript\n\n{content}\n"
    )
    return {"requiresApproval": False, "pack": pack, "chars": len(pack), "session": session}


def mcp_tool_text(payload):
    if isinstance(payload, str):
        text = payload
    else:
        text = json.dumps(payload, ensure_ascii=False, indent=2)
    return {"content": [{"type": "text", "text": text}]}


def ensure_mesh_structure(base):
    """Create the standard .mesh directory skeleton at a project root."""
    mesh = base / ".mesh"
    dirs = [
        mesh / "pulse",
        mesh / "tasks",
        mesh / "tasks" / "active",
        mesh / "tasks" / "archived",
        mesh / "shared",
        mesh / "shared" / "status",
        mesh / "shared" / "historical",
        mesh / "shared" / "evolution",
    ]
    for d in dirs:
        d.mkdir(parents=True, exist_ok=True)

    defaults = {
        "context.md": "# Shared Context\n\nProject context that every agent should read before starting work.\n",
        "decisions.md": "# Decisions Log\n\nAppend-only architecture and workflow decisions.\n",
        "blockers.md": "# Blockers\n\nTrack blockers that need human input or cross-agent coordination.\n",
    }
    for name, content in defaults.items():
        p = mesh / "shared" / name
        if not p.exists():
            write_text(p, content)


def read_json(path):
    try:
        with path.open("r", encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        die(f"Missing file: {path}")
    except json.JSONDecodeError as e:
        die(f"Invalid JSON in {path}: {e}")


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    stamp = f"{os.getpid()}-{hashlib.sha256(str(path).encode('utf-8')).hexdigest()[:8]}"
    tmp = path.with_name(f".{path.name}.tmp-{stamp}")
    with tmp.open("w", encoding="utf-8") as f:
        f.write(content)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def atomic_write_bytes(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    stamp = f"{os.getpid()}-{hashlib.sha256(str(path).encode('utf-8')).hexdigest()[:8]}"
    tmp = path.with_name(f".{path.name}.tmp-{stamp}")
    with tmp.open("wb") as f:
        f.write(content)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def write_json(path, data):
    content = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
    atomic_write(path, content)


def read_text(path):
    with path.open("r", encoding="utf-8") as f:
        return f.read()


def write_text(path, content):
    atomic_write(path, content)


def append_text(path, content):
    existing = read_text(path) if path.exists() else ""
    atomic_write(path, existing + content)


@contextlib.contextmanager
def mesh_lock(root):
    """Serialize mesh mutations in multi-terminal usage."""
    lock_path = root / ".mesh" / ".lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as f:
        try:
            import fcntl
            fcntl.flock(f.fileno(), fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(f.fileno(), fcntl.LOCK_UN)
        except ImportError:
            # Best-effort fallback for platforms without fcntl. Atomic writes still
            # protect file integrity, but same-file read/modify/write races may need
            # an external scheduler lock on those platforms.
            yield


def is_agent_name(value):
    if not isinstance(value, str):
        return False
    if not value:
        return False
    allowed = "abcdefghijklmnopqrstuvwxyz0123456789-"
    for i, ch in enumerate(value):
        if ch not in allowed:
            return False
        if i == 0 and ch == "-":
            return False
    return True


def is_task_id(value):
    return is_agent_name(value)


def validate_by_schema(data, schema, path="$"):
    errors = []

    stype = schema.get("type")
    if stype:
        if stype == "object" and not isinstance(data, dict):
            return [f"{path}: expected object"]
        if stype == "array" and not isinstance(data, list):
            return [f"{path}: expected array"]
        if stype == "string" and not isinstance(data, str):
            return [f"{path}: expected string"]
        if stype == "number" and not isinstance(data, (int, float)):
            return [f"{path}: expected number"]
        if stype == "boolean" and not isinstance(data, bool):
            return [f"{path}: expected boolean"]

    if "const" in schema and data != schema["const"]:
        errors.append(f"{path}: expected const {schema['const']!r}")

    if "enum" in schema and data not in schema["enum"]:
        errors.append(f"{path}: expected one of {schema['enum']}")

    if isinstance(data, str):
        if "minLength" in schema and len(data) < schema["minLength"]:
            errors.append(f"{path}: length < {schema['minLength']}")
        if "maxLength" in schema and len(data) > schema["maxLength"]:
            errors.append(f"{path}: length > {schema['maxLength']}")
        pattern = schema.get("pattern")
        if pattern == "^[a-z0-9][a-z0-9-]*$":
            if not is_agent_name(data):
                errors.append(f"{path}: does not match pattern {pattern}")
        if schema.get("format") == "date-time" and parse_iso(data) is None:
            errors.append(f"{path}: invalid date-time format")

    if isinstance(data, (int, float)):
        if "minimum" in schema and data < schema["minimum"]:
            errors.append(f"{path}: value < {schema['minimum']}")
        if "maximum" in schema and data > schema["maximum"]:
            errors.append(f"{path}: value > {schema['maximum']}")

    if isinstance(data, list):
        if "maxItems" in schema and len(data) > schema["maxItems"]:
            errors.append(f"{path}: too many items (> {schema['maxItems']})")
        item_schema = schema.get("items")
        if item_schema:
            for idx, item in enumerate(data):
                errors.extend(validate_by_schema(item, item_schema, f"{path}[{idx}]"))

    if isinstance(data, dict):
        required = schema.get("required", [])
        for key in required:
            if key not in data:
                errors.append(f"{path}: missing required field '{key}'")

        props = schema.get("properties", {})
        for key, subschema in props.items():
            if key in data:
                errors.extend(validate_by_schema(data[key], subschema, f"{path}.{key}"))

        additional = schema.get("additionalProperties")
        if isinstance(additional, dict):
            declared = set(props.keys())
            for key, value in data.items():
                if key not in declared:
                    errors.extend(validate_by_schema(value, additional, f"{path}.{key}"))

    return errors


