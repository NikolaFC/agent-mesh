def collect_validation_errors(paths):
    project_root = Path(__file__).resolve().parent.parent
    pulse_schema = read_json(project_root / "schema" / "pulse-v1.json")
    task_schema = read_json(project_root / "schema" / "task-v1.json")

    invalid = []
    for pf in collect_pulse_files(paths):
        data = read_json(pf)
        errs = validate_by_schema(data, pulse_schema)
        if errs:
            invalid.append({"kind": "pulse", "path": str(pf), "errors": errs})

    for tf in collect_task_files(paths, include_archived=True):
        data = read_json(tf)
        errs = validate_by_schema(data, task_schema)
        if errs:
            invalid.append({"kind": "task", "path": str(tf), "errors": errs})
    return invalid


def rel_mesh_path(path):
    parts = path.parts
    if ".mesh" in parts:
        idx = parts.index(".mesh")
        return "/".join(parts[idx:])
    return str(path)


def boundary_text_scores(text):
    """Heuristic scores for advisory Memory-vs-Skill boundary warnings."""
    sop_score = 0
    status_score = 0
    numbered_or_checklist = 0
    has_command_or_code = False
    has_procedure_heading = False

    command_re = re.compile(
        r"^(mesh|git|gh|python3?|node|npm|pnpm|uv|make|docker|curl|cd|export|sudo|systemctl|openclaw|hermes)\b"
    )
    procedure_heading_re = re.compile(
        r"^#{1,6}\s+.*(sop|runbook|procedure|steps?|commands?|checklist|操作步骤|步骤|命令|检查清单)",
        re.IGNORECASE,
    )
    numbered_re = re.compile(r"^\s*\d+[.)]\s+")
    status_line_re = re.compile(
        r"^\s*(status|issue|current|decision|context|consequences|resolution|resolved|blocked|next step|evidence|observed|root cause)\s*:",
        re.IGNORECASE,
    )
    dated_heading_re = re.compile(r"^#{1,6}\s+\[?(resolved\s+)?\d{4}-\d{2}-\d{2}", re.IGNORECASE)

    for line in text.splitlines():
        stripped = line.strip()
        lower = stripped.lower()
        if not stripped:
            continue
        if stripped.startswith("```"):
            has_command_or_code = True
            if "bash" in lower or "sh" in lower or "shell" in lower:
                sop_score += 3
            continue
        if command_re.match(stripped):
            sop_score += 3
            has_command_or_code = True
        if numbered_re.match(line) or stripped.startswith("- [ ]"):
            sop_score += 1
            numbered_or_checklist += 1
        if procedure_heading_re.match(stripped):
            sop_score += 3
            has_procedure_heading = True
        if any(token in lower for token in ("must run", "run `", "execute `", "copy the", "required command")):
            sop_score += 1
        if status_line_re.match(stripped):
            status_score += 2
        if dated_heading_re.match(stripped):
            status_score += 2
        if any(token in lower for token in ("active", "resolved", "superseded", "awaiting", "current production", "pr #", "ci passed", "ci failed")):
            status_score += 1

    return {
        "sopScore": sop_score,
        "statusScore": status_score,
        "numberedOrChecklist": numbered_or_checklist,
        "hasCommandOrCode": has_command_or_code,
        "hasProcedureHeading": has_procedure_heading,
    }


def collect_boundary_warnings(paths):
    """Advisory warnings for mixed memory/status vs SOP/reference content.

    These warnings are intentionally light: they do not fail validation and they
    never move content automatically. They only point agents at the right layer.
    """
    warnings = []

    for name in ("context.md", "decisions.md", "blockers.md"):
        path = paths["shared"] / name
        if not path.exists():
            continue
        scores = boundary_text_scores(read_text(path))
        if scores["sopScore"] >= 8 and (
            scores["hasCommandOrCode"] or (scores["hasProcedureHeading"] and scores["numberedOrChecklist"] >= 3)
        ):
            warnings.append({
                "kind": "boundary",
                "path": rel_mesh_path(path),
                "issue": "memory/status file contains substantial SOP-like steps or commands",
                "suggestion": "Move reusable procedure material to .mesh/shared/sop/ or docs/guides; keep only thin facts/status and links here.",
                "scores": scores,
            })

    sop_dir = paths["shared"] / "sop"
    if sop_dir.is_dir():
        for path in sorted(sop_dir.glob("*.md")):
            scores = boundary_text_scores(read_text(path))
            if scores["statusScore"] >= 8 and scores["sopScore"] < 6:
                warnings.append({
                    "kind": "boundary",
                    "path": rel_mesh_path(path),
                    "issue": "SOP/reference file looks mostly like one-off status, facts, or task history",
                    "suggestion": "Move current truth to context/status/task history and leave only repeatable procedure/reference material in SOP.",
                    "scores": scores,
                })

    return warnings


def cmd_validate(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    invalid = collect_validation_errors(paths)
    boundary_warnings = collect_boundary_warnings(paths)

    if getattr(args, "json", False):
        print(json.dumps({"ok": not invalid, "invalid": invalid, "warnings": boundary_warnings}, ensure_ascii=False, indent=2))
        if invalid:
            raise SystemExit(1)
        return

    for item in invalid:
        fail(f"❌ {item['path']}")
        for e in item["errors"]:
            print(f"   - {e}")

    for item in boundary_warnings:
        warn(f"⚠️  {item['path']}: {item['issue']}")
        print(f"   → {item['suggestion']}")

    if invalid:
        raise SystemExit(1)

    success("✅ Validation passed")


def normalize_legacy_task(task, task_id):
    """Add missing v1 fields / safe aliases without changing business conclusions."""
    changed = []
    now = now_iso()

    defaults = {
        "schema": TASK_SCHEMA_ID,
        "id": task_id,
        "type": "ops",
        "title": task_id,
        "status": "open",
        "verdict": "pending",
        "priority": "medium",
        "assignedTo": task.get("assignee") or "openclaw",
        "createdAt": task.get("created") or task.get("updatedAt") or task.get("updated") or now,
        "updatedAt": task.get("updatedAt") or task.get("updated") or now,
    }
    for key, value in defaults.items():
        if key not in task or task.get(key) in {None, ""}:
            task[key] = value
            changed.append(f"set {key}")

    priority_aliases = {"P0": "critical", "P1": "high", "P2": "medium", "P3": "low"}
    if task.get("priority") in priority_aliases:
        old = task["priority"]
        task["priority"] = priority_aliases[old]
        changed.append(f"priority {old}->{task['priority']}")
    elif task.get("priority") not in TASK_PRIORITIES:
        old = task.get("priority")
        task["priority"] = "medium"
        changed.append(f"priority {old}->medium")

    if task.get("type") not in TASK_TYPES:
        old = task.get("type")
        task["type"] = "ops"
        changed.append(f"type {old}->ops")
    if task.get("status") not in TASK_STATUS:
        old = task.get("status")
        task["status"] = "open"
        changed.append(f"status {old}->open")
    if task.get("verdict") not in TASK_VERDICTS:
        old = task.get("verdict")
        task["verdict"] = "pending"
        changed.append(f"verdict {old}->pending")
    if "progress" not in task:
        task["progress"] = 1.0 if task.get("status") in TERMINAL_TASK_STATUS else 0.0
        changed.append("set progress")

    history = task.get("history")
    if not isinstance(history, list):
        task["history"] = []
        changed.append("set history")
    else:
        for entry in history:
            if not isinstance(entry, dict):
                continue
            if not entry.get("agent"):
                entry["agent"] = task.get("assignedTo") or "openclaw"
                changed.append("fill history agent")
            if not entry.get("at"):
                entry["at"] = task.get("updatedAt") or now
                changed.append("fill history at")
            if entry.get("action") not in TASK_ACTIONS:
                old = entry.get("action")
                entry["action"] = "commented"
                changed.append(f"history action {old}->commented")

    return changed


def runtime_snapshot():
    import shutil
    import subprocess
    exe = shutil.which("openclaw") or ""
    resolved = ""
    version = ""
    if exe:
        try:
            resolved = subprocess.run(["readlink", "-f", exe], capture_output=True, text=True, timeout=5).stdout.strip()
        except Exception:
            resolved = ""
        try:
            version = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=10).stdout.strip()
        except Exception:
            version = ""
    return {"openclawExecutable": exe, "openclawResolvedPath": resolved, "openclawVersion": version}


def update_runtime_snapshot(paths):
    """Write mutable runtime facts to shared/status, not context.md."""
    import subprocess

    snap = runtime_snapshot()
    gateway_state = ""
    gateway_exec = ""
    try:
        gateway_state = subprocess.run(["systemctl", "--user", "is-active", "openclaw-gateway"], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        gateway_state = "unknown"
    try:
        gateway_exec = subprocess.run(["systemctl", "--user", "show", "openclaw-gateway", "-p", "ExecStart", "--value"], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        gateway_exec = "unknown"

    status_dir = paths.get("status") or (paths["shared"] / "status")
    status_file = status_dir / "openclaw-runtime.md"
    content = (
        "# OpenClaw Runtime Status\n\n"
        "Classification: operational memory/status. This is the mutable runtime snapshot; `context.md` should only link here.\n\n"
        "<!-- agent-mesh-runtime-snapshot:start -->\n"
        f"- OpenClaw version: `{snap.get('openclawVersion') or 'unknown'}`\n"
        f"- OpenClaw executable: `{snap.get('openclawExecutable') or 'unknown'}`\n"
        f"- OpenClaw resolved path: `{snap.get('openclawResolvedPath') or 'unknown'}`\n"
        f"- User gateway service state: `{gateway_state or 'unknown'}`\n"
        f"- User gateway ExecStart: `{gateway_exec or 'unknown'}`\n"
        "<!-- agent-mesh-runtime-snapshot:end -->\n\n"
        "Rule: before risky OpenClaw work, verify both the CLI path and the gateway ExecStart path. Do not infer the running gateway bundle from `which openclaw` alone.\n"
    )

    changed = []
    old_status = status_file.read_text(encoding="utf-8") if status_file.exists() else ""
    if old_status != content:
        write_text(status_file, content)
        changed.append({"path": str(status_file), "changes": ["updated runtime snapshot"]})

    # Migrate legacy inline context snapshot out of context.md if present.
    context = paths["shared"] / "context.md"
    start = "<!-- agent-mesh-runtime-snapshot:start -->"
    end = "<!-- agent-mesh-runtime-snapshot:end -->"
    if context.exists():
        text = read_text(context)
        if start in text and end in text:
            before, rest = text.split(start, 1)
            _, after = rest.split(end, 1)
            new_text = before.rstrip() + "\n\n" + after.lstrip("\n")
            if new_text != text:
                write_text(context, new_text)
                changed.append({"path": str(context), "changes": ["removed inline runtime snapshot"]})
    return changed


def cmd_doctor(args):
    root = require_mesh_root()
    paths = mesh_paths(root)
    fix_safe = getattr(args, "fix_safe", False)
    report = {"ok": True, "fixed": [], "warnings": []}

    for task_file in list(collect_task_files(paths, include_archived=False)):
        task = read_json(task_file)
        changes = normalize_legacy_task(task, task.get("id") or task_file.stem)
        terminal = task.get("status") in TERMINAL_TASK_STATUS

        if changes and fix_safe:
            write_json(task_file, task)
            report["fixed"].append({"path": str(task_file), "changes": changes})
        elif changes:
            report["warnings"].append({"path": str(task_file), "changesAvailable": changes})

        if terminal:
            dst = paths["archived"] / task_file.name
            if fix_safe:
                if dst.exists():
                    report["warnings"].append({"path": str(task_file), "issue": f"archive target exists: {dst}"})
                else:
                    task_file.rename(dst)
                    report["fixed"].append({"path": str(task_file), "changes": [f"moved terminal task to {dst}"]})
            else:
                report["warnings"].append({"path": str(task_file), "issue": f"terminal task still active: {task.get('status')}"})

    if fix_safe:
        runtime_changes = update_runtime_snapshot(paths)
        if runtime_changes:
            report["fixed"].extend(runtime_changes)
        rebuild_indexes(root, paths)

    report["warnings"].extend(collect_boundary_warnings(paths))

    invalid = collect_validation_errors(paths)
    if invalid:
        report["ok"] = False
        report["validationErrors"] = invalid

    if getattr(args, "json", False):
        print(json.dumps(report, ensure_ascii=False, indent=2))
        if not report["ok"]:
            raise SystemExit(1)
        return

    for item in report["fixed"]:
        info(f"🔧 {item['path']}: {', '.join(item['changes'])}")
    for item in report["warnings"]:
        warn(f"⚠️  {item}")
    if invalid:
        warn(f"🚫 Validation still has {len(invalid)} invalid file(s)")
        raise SystemExit(1)
    success("✅ Doctor complete")


def gh_json(args_str):
    """Run gh CLI and return parsed JSON, or None on failure."""
    import subprocess
    try:
        r = subprocess.run(
            f"gh {args_str}",
            shell=True, capture_output=True, text=True, timeout=30,
        )
        if r.returncode != 0:
            warn(f"gh failed: {r.stderr.strip()}")
            return None
        return json.loads(r.stdout)
    except (json.JSONDecodeError, subprocess.TimeoutExpired, FileNotFoundError) as e:
        warn(f"gh error: {e}")
        return None


def gh_pr_to_mesh_status(ci_status, is_merged, is_draft, review_decision):
    """Map GitHub PR state to mesh task status."""
    if is_merged:
        return "merged"
    if ci_status == "FAILURE":
        return "ci-fail"
    if ci_status == "SUCCESS":
        return "ci-pass"
    if review_decision == "APPROVED":
        return "review"
    if is_draft:
        return "open"
    return "in-progress"


def gh_estimate_progress(ci_status, review_decision):
    """Estimate progress from CI + review state."""
    p = 0.3
    if ci_status == "SUCCESS":
        p += 0.4
    elif ci_status == "FAILURE":
        p += 0.1
    if review_decision == "APPROVED":
        p += 0.2
    elif review_decision == "CHANGES_REQUESTED":
        p += 0.05
    return round(min(p, 1.0), 2)


def cmd_sync(args):
    # Check gh CLI availability
    import subprocess
    try:
        r = subprocess.run("gh --version", shell=True, capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            die("GitHub CLI (gh) not found. Install: https://cli.github.com")
    except FileNotFoundError:
        die("GitHub CLI (gh) not found. Install: https://cli.github.com")
    # Check gh auth
    r = subprocess.run("gh auth status", shell=True, capture_output=True, text=True, timeout=10)
    if r.returncode != 0:
        die("gh not authenticated. Run: gh auth login")

    repo = args.repo
    if not repo:
        try:
            r = subprocess.run(
                "gh repo view --json nameWithOwner -q .nameWithOwner",
                shell=True, capture_output=True, text=True, timeout=10,
            )
            if r.returncode == 0 and r.stdout.strip():
                repo = r.stdout.strip()
        except Exception:
            pass
    if not repo:
        die("Could not detect repo. Use --repo owner/name.")

    info(f"📡 Syncing from {repo}...")

    # Fetch open PRs
    prs = gh_json(
        f"pr list --repo {repo} --state open --limit 100 "
        "--json number,title,state,isDraft,reviewDecision,statusCheckRollup,author,headRefName"
    )
    if prs is None:
        die("Failed to fetch PRs from GitHub.")

    # Fetch recently merged PRs (last 7 days)
    merged_prs = gh_json(
        f"pr list --repo {repo} --state merged --limit 50 "
        "--json number,title,state,mergedAt,author"
    )
    if merged_prs is None:
        merged_prs = []

    root = require_mesh_root()
    paths = mesh_paths(root)

    # Load existing tasks
    existing = {}
    for f in collect_task_files(paths, include_archived=False):
        task = read_json(f)
        existing[task.get("id", f.stem)] = task

    created, updated, unchanged = 0, 0, 0
    now = now_iso()

    # Process open PRs
    for pr in prs:
        num = pr["number"]
        task_id = f"pr-{num}"
        title = pr.get("title", f"PR #{num}")

        # Determine CI status from check rollup
        checks = pr.get("statusCheckRollup") or []
        ci_status = "PENDING"
        if checks:
            conclusions = [c.get("conclusion") or c.get("status") for c in checks]
            if "FAILURE" in conclusions:
                ci_status = "FAILURE"
            elif all(s == "SUCCESS" for s in conclusions):
                ci_status = "SUCCESS"

        is_merged = pr.get("state") == "MERGED"
        is_draft = pr.get("isDraft", False)
        review_decision = pr.get("reviewDecision") or "pending"

        mesh_status = gh_pr_to_mesh_status(ci_status, is_merged, is_draft, review_decision)
        progress = gh_estimate_progress(ci_status, review_decision)

        if task_id in existing:
            task = existing[task_id]
            old_status = task.get("status")
            if old_status != mesh_status:
                task["status"] = mesh_status
                task["progress"] = progress
                task["updatedAt"] = now
                history = task.get("history", [])
                history.append({
                    "agent": "mesh-sync",
                    "action": "validated",
                    "summary": f"GitHub sync: {old_status} → {mesh_status} (CI: {ci_status}, review: {review_decision})",
                    "at": now,
                })
                task["history"] = history
                write_json(paths["active"] / f"{task_id}.json", task)
                updated += 1
                info(f"  📝 {task_id}: {old_status} → {mesh_status}")
            else:
                unchanged += 1
        else:
            # New task from GitHub
            task = {
                "schema": TASK_SCHEMA_ID,
                "id": task_id,
                "type": "upstream-pr",
                "title": title,
                "status": mesh_status,
                "verdict": "pending",
                "priority": "medium",
                "assignedTo": pr.get("author", {}).get("login", "unknown"),
                "createdAt": now,
                "updatedAt": now,
                "progress": progress,
                "links": {
                    "github": f"https://github.com/{repo}/pull/{num}",
                },
                "history": [{
                    "agent": "mesh-sync",
                    "action": "created",
                    "summary": f"Auto-discovered from GitHub: {title}",
                    "at": now,
                }],
            }
            write_json(paths["active"] / f"{task_id}.json", task)
            created += 1
            info(f"  ✨ {task_id}: {mesh_status} — {title}")

    # Process merged PRs → mark existing tasks as merged
    for pr in merged_prs:
        num = pr["number"]
        task_id = f"pr-{num}"
        if task_id in existing:
            task = existing[task_id]
            if task.get("status") != "merged":
                old_status = task["status"]
                task["status"] = "merged"
                task["progress"] = 1.0
                task["updatedAt"] = now
                history = task.get("history", [])
                history.append({
                    "agent": "mesh-sync",
                    "action": "merged",
                    "summary": "PR merged on GitHub",
                    "at": now,
                })
                task["history"] = history
                write_json(paths["active"] / f"{task_id}.json", task)
                updated += 1
                info(f"  🔀 {task_id}: {old_status} → merged")

    success(f"\n✅ Sync complete: {created} created, {updated} updated, {unchanged} unchanged")


