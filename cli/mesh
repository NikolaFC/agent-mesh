def write_mcp_wire_message(stream, message):
    payload = json.dumps(message, ensure_ascii=False).encode("utf-8")
    stream.write(f"Content-Length: {len(payload)}\r\n\r\n".encode("ascii") + payload)
    stream.flush()


def read_mcp_wire_message_from_fd(fd, timeout=10):
    import select
    deadline = datetime.datetime.now().timestamp() + timeout
    buf = b""
    while b"\r\n\r\n" not in buf and b"\n\n" not in buf:
        remaining = deadline - datetime.datetime.now().timestamp()
        if remaining <= 0:
            raise TimeoutError("timed out waiting for MCP headers")
        ready, _, _ = select.select([fd], [], [], remaining)
        if not ready:
            raise TimeoutError("timed out waiting for MCP headers")
        chunk = os.read(fd, 1)
        if not chunk:
            raise EOFError("MCP stream closed before headers")
        buf += chunk
    sep = b"\r\n\r\n" if b"\r\n\r\n" in buf else b"\n\n"
    header, rest = buf.split(sep, 1)
    length = None
    for line in header.decode("ascii", errors="replace").splitlines():
        if line.lower().startswith("content-length:"):
            length = int(line.split(":", 1)[1].strip())
            break
    if length is None:
        # Also accept newline-delimited JSON for tiny test clients.
        text = (header + sep + rest).decode("utf-8")
        return json.loads(text)
    body = rest
    while len(body) < length:
        remaining = deadline - datetime.datetime.now().timestamp()
        if remaining <= 0:
            raise TimeoutError("timed out waiting for MCP body")
        ready, _, _ = select.select([fd], [], [], remaining)
        if not ready:
            raise TimeoutError("timed out waiting for MCP body")
        chunk = os.read(fd, length - len(body))
        if not chunk:
            raise EOFError("MCP stream closed before body")
        body += chunk
    return json.loads(body[:length].decode("utf-8"))


def read_mcp_wire_message(stream):
    header = b""
    while b"\r\n\r\n" not in header and b"\n\n" not in header:
        ch = stream.read(1)
        if not ch:
            return None
        header += ch
    sep = b"\r\n\r\n" if b"\r\n\r\n" in header else b"\n\n"
    header, rest = header.split(sep, 1)
    length = None
    for line in header.decode("ascii", errors="replace").splitlines():
        if line.lower().startswith("content-length:"):
            length = int(line.split(":", 1)[1].strip())
            break
    if length is None:
        try:
            return json.loads((header + sep + rest).decode("utf-8"))
        except json.JSONDecodeError:
            return None
    body = rest
    while len(body) < length:
        chunk = stream.read(length - len(body))
        if not chunk:
            return None
        body += chunk
    return json.loads(body[:length].decode("utf-8"))


def call_stdio_mcp_server(server, method, params=None, timeout=15):
    if not server.get("command"):
        die("Only stdio downstream MCP servers with a command are supported in this experimental proxy")
    cmd = [server["command"]] + list(server.get("args", []))
    env = os.environ.copy()
    env.update({str(k): str(v) for k, v in server.get("env", {}).items()})
    cwd = server.get("cwd") or server.get("workingDirectory")
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd=cwd, env=env)
    try:
        write_mcp_wire_message(proc.stdin, {
            "jsonrpc": "2.0",
            "id": "init",
            "method": "initialize",
            "params": {
                "protocolVersion": "2024-11-05",
                "capabilities": {},
                "clientInfo": {"name": "agent-mesh", "version": VERSION},
            },
        })
        init = read_mcp_wire_message_from_fd(proc.stdout.fileno(), timeout=timeout)
        if init.get("error"):
            die(f"Downstream MCP initialize failed: {init['error']}")
        write_mcp_wire_message(proc.stdin, {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}})
        req_id = "call"
        write_mcp_wire_message(proc.stdin, {"jsonrpc": "2.0", "id": req_id, "method": method, "params": params or {}})
        while True:
            msg = read_mcp_wire_message_from_fd(proc.stdout.fileno(), timeout=timeout)
            if msg.get("id") == req_id:
                if msg.get("error"):
                    die(f"Downstream MCP call failed: {msg['error']}")
                return msg.get("result")
    finally:
        with contextlib.suppress(Exception):
            proc.terminate()
        with contextlib.suppress(Exception):
            proc.wait(timeout=2)
        with contextlib.suppress(Exception):
            proc.kill()


