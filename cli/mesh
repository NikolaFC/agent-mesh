PULSE_SCHEMA_ID = "agent-mesh/pulse/v1"
TASK_SCHEMA_ID = "agent-mesh/task/v1"

PULSE_STATUS = {"idle", "working", "blocked", "reviewing", "done"}
PULSE_ACTIONS = {
    "commit", "pr-created", "pr-updated", "ci-pass", "ci-fail", "deploy", "test", "review",
    "blocked", "unblocked", "note", "config", "handoff",
}
TASK_TYPES = {"upstream-pr", "feature", "bugfix", "investigation", "refactor", "docs", "ops", "research", "coordination"}
