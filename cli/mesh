def cmd_evolution_index(args):
    """Generate a searchable JSONL index from evolution logs."""
    root = require_mesh_root()
    paths = mesh_paths(root)
    config = load_mesh_config(root)

    evo_files = collect_evolution_files(paths)
    if not evo_files:
        warn("No evolution logs to index.")
        return

    idx_cfg = config.get("evolution", {}).get("index", {})
    idx_rel = args.output or idx_cfg.get("path", ".mesh/shared/evolution/index.jsonl")
    idx_path = root / idx_rel if not Path(idx_rel).is_absolute() else Path(idx_rel)
    idx_path.parent.mkdir(parents=True, exist_ok=True)

    entries = []
    for f in evo_files:
        agent = f.stem
        content = read_text(f)
        chunks = content.split("\n## [")
        for chunk in chunks[1:]:
            if "]" not in chunk:
                continue
            ts_rest = chunk.split("]", 1)
            ts_str = ts_rest[0].strip()
            rest = ts_rest[1].strip() if len(ts_rest) > 1 else ""

            category = ""
            file_changed = ""
            if " — " in rest:
                header_part, summary = rest.split("\n", 1) if "\n" in rest else (rest, "")
                parts = header_part.split(" — ", 1)
                category = parts[0].strip()
                file_changed = parts[1].strip() if len(parts) > 1 else ""
            else:
                summary = rest

            entry = {
                "agent": agent,
                "timestamp": ts_str,
                "category": category,
                "file": file_changed,
                "summary": summary.strip()[:500],
            }
            entries.append(entry)

    with idx_path.open("w", encoding="utf-8") as out:
        for e in entries:
            out.write(json.dumps(e, ensure_ascii=False) + "\n")

    success(f"✅ Indexed {len(entries)} evolution entries → {idx_rel}")
    if idx_cfg.get("experimental"):
        info("🔬 Experimental feature — index format may change.")


def build_parser():
    parser = argparse.ArgumentParser(prog="mesh", description="Agent Mesh CLI")
    parser.add_argument("--version", action="version", version=f"Agent Mesh {VERSION}")
    sub = parser.add_subparsers(dest="command")

    p_init = sub.add_parser("init", help="Initialize .mesh directory")
    p_init.set_defaults(func=cmd_init)

    p_status = sub.add_parser("status", help="Show mesh status overview")
    p_status.set_defaults(func=cmd_status)

    p_root = sub.add_parser("root", help="Show detected mesh root and .mesh path")
    p_root.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    p_root.set_defaults(func=cmd_root)

    p_pulse = sub.add_parser("pulse", help="Pulse operations")
    pulse_sub = p_pulse.add_subparsers(dest="pulse_command")

    p_pulse_read = pulse_sub.add_parser("read", help="Read pulse files")
    p_pulse_read.add_argument("--agent", help="Agent name")
    p_pulse_read.add_argument("--all", action="store_true", help="Read all agents")
