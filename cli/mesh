def normalize_task_action(value):
    if not isinstance(value, str):
        return value
    normalized = value.strip().lower().replace("_", "-")
    return TASK_ACTION_ALIASES.get(normalized, normalized)


def task_action_help():
    aliases = ", ".join(f"{k}->{v}" for k, v in sorted(TASK_ACTION_ALIASES.items()))
    return f"Allowed: {sorted(TASK_ACTIONS)}. Accepted aliases: {aliases}"


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_iso(value):
    if not isinstance(value, str):
        return None
    try:
        if value.endswith("Z"):
            value = value[:-1] + "+00:00"
        return datetime.datetime.fromisoformat(value)
    except ValueError:
        return None


def supports_color():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


USE_COLOR = supports_color()


def color(text, code):
    if not USE_COLOR:
        return text
    return f"\033[{code}m{text}\033[0m"


def info(msg):
    print(color(msg, "36"))


def success(msg):
    print(color(msg, "32"))


def warn(msg):
    print(color(msg, "33"))


def fail(msg):
    print(color(msg, "31"), file=sys.stderr)


def die(msg, hint_init=False, code=1):
    fail(f"❌ {msg}")
    if hint_init:
        print("💡 Did you run `mesh init`?", file=sys.stderr)
    raise SystemExit(code)


def detect_mesh_root(start=None):
    # Honour MESH_ROOT env var if set
    env_root = os.environ.get("MESH_ROOT")
    if env_root:
        p = Path(env_root).resolve()
        if (p / ".mesh").is_dir():
            return p
        # If MESH_ROOT points to .mesh/ itself
        if p.is_dir() and p.name == ".mesh" and p.parent:
            return p.parent
    cur = Path(start or os.getcwd()).resolve()
    while True:
        mesh_dir = cur / ".mesh"
        if mesh_dir.is_dir():
            return cur
        parent = cur.parent
        if parent == cur:
            return None
        cur = parent


def require_mesh_root():
    root = detect_mesh_root()
    if not root:
        die("Could not find .mesh directory from current path.", hint_init=True)
    return root


