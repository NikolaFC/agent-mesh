def resolve_shared_file(paths, value):
    name = value.strip()
    allowed = {"context", "decisions", "blockers", "context.md", "decisions.md", "blockers.md"}
    if name not in allowed:
        die("Shared file must be one of: context, decisions, blockers")
    if not name.endswith(".md"):
        name += ".md"
    return paths["shared"] / name


