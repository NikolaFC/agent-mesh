def migrate_rel(path, root):
    return path.resolve().relative_to(root.resolve()).as_posix()


def is_migrate_excluded(rel):
    return bool(MIGRATE_EXCLUDE_RE.search(rel))


def collect_migration_plan(root, preset="openclaw-persona", include_skills=False, include_memory=False, max_file_bytes=5_000_000, max_total_bytes=50_000_000):
    root = root.expanduser().resolve()
    if preset != "openclaw-persona":
        die("Only migrate preset 'openclaw-persona' is supported in this version.")
    candidates = []
    for rel in OPENCLAW_PERSONA_FILES:
        p = root / rel
        if p.is_file():
            candidates.append(p)
    if include_skills:
        for base in (root / "skills", root / "agents"):
            if base.is_dir():
                candidates.extend(p for p in base.rglob("*") if p.is_file())
    if include_memory:
        memory_root = root / "memory"
        if memory_root.is_dir():
            for p in memory_root.rglob("*"):
                if not p.is_file():
                    continue
                rel = migrate_rel(p, root)
                parts = Path(rel).parts
                if len(parts) > 1 and parts[0] == "memory" and parts[1] in {".dreams", "archives", "session-archive", "sessions", "raw", "tmp"}:
                    continue
                if p.suffix.lower() not in {".md", ".json", ".jsonl", ".txt"}:
                    continue
                candidates.append(p)

    files = []
    skipped = []
    total = 0
    seen = set()
    for path in sorted(candidates, key=lambda p: migrate_rel(p, root)):
        rel = migrate_rel(path, root)
        if rel in seen:
            continue
        seen.add(rel)
        if is_migrate_excluded(rel):
            skipped.append({"path": rel, "reason": "sensitive-or-runtime-path"})
            continue
        size = path.stat().st_size
        if size > max_file_bytes:
            skipped.append({"path": rel, "reason": f"file-too-large>{max_file_bytes}"})
            continue
        if total + size > max_total_bytes:
            skipped.append({"path": rel, "reason": f"bundle-too-large>{max_total_bytes}"})
            continue
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        files.append({"path": rel, "bytes": size, "sha256": digest})
        total += size
    warnings = []
    if not files:
        warnings.append("No files matched the migration preset.")
    if include_skills:
        warnings.append("Skills may contain scripts/assets. Review the manifest before applying on another device.")
    if include_memory:
        warnings.append("Memory migration includes stable memory files only; raw session archives/dream corpora/runtime memory are skipped by default.")
    warnings.append("Secrets, credentials, device pairing state, .env files, logs, and runtime state are excluded by default.")
    return {"root": str(root), "preset": preset, "includeSkills": include_skills, "includeMemory": include_memory, "files": files, "skipped": skipped, "totalBytes": total, "warnings": warnings}


def migration_manifest(plan, approved_by=None):
    content_hash = hashlib.sha256()
    for item in plan["files"]:
        content_hash.update(item["path"].encode("utf-8") + b"\0" + item["sha256"].encode("utf-8") + b"\0")
    now = now_iso()
    manifest = {
        "schema": MIGRATE_SCHEMA_ID,
        "createdAt": now,
        "preset": plan["preset"],
        "includeSkills": plan["includeSkills"],
        "includeMemory": plan.get("includeMemory", False),
        "files": plan["files"],
        "skipped": plan["skipped"],
        "totalBytes": plan["totalBytes"],
        "contentHash": content_hash.hexdigest(),
        "approval": {
            "approved": bool(approved_by),
            "approvedBy": approved_by or "",
            "approvedAt": now if approved_by else "",
            "scope": "copy listed files only; no secrets/runtime state",
        },
        "warnings": plan["warnings"],
    }
    return manifest


def read_migration_manifest_from_bundle(bundle):
    with tarfile.open(bundle, "r:gz") as tar:
        try:
            member = tar.getmember(MIGRATE_MANIFEST_NAME)
        except KeyError:
            die("Migration bundle missing manifest.")
        f = tar.extractfile(member)
        if not f:
            die("Migration manifest could not be read.")
        return json.loads(f.read().decode("utf-8"))


def validate_migration_manifest(manifest):
    if manifest.get("schema") != MIGRATE_SCHEMA_ID:
        die("Unsupported migration manifest schema.")
    files = manifest.get("files")
    if not isinstance(files, list):
        die("Invalid migration manifest: files must be a list.")
    for item in files:
        rel = item.get("path") if isinstance(item, dict) else None
        if not rel or rel.startswith("/") or ".." in Path(rel).parts:
            die(f"Invalid migration path in manifest: {rel!r}")
        if is_migrate_excluded(rel):
            die(f"Refusing sensitive/runtime path in manifest: {rel}")


