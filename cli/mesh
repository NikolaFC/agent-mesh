def safe_target_path(target_root, rel):
    target_root = target_root.expanduser().resolve()
    out = (target_root / rel).resolve()
    if not str(out).startswith(str(target_root) + os.sep) and out != target_root:
        die(f"Unsafe migration path: {rel}")
    return out


def cmd_migrate_apply(args):
    bundle = Path(args.bundle).expanduser().resolve()
    target_root = Path(args.target_root).expanduser().resolve()
    manifest = read_migration_manifest_from_bundle(bundle)
    validate_migration_manifest(manifest)
    approval = manifest.get("approval") or {}
    if not approval.get("approved") and not args.allow_unapproved:
        die("Migration capsule is not host-approved. Re-export with --approved-by or pass --allow-unapproved deliberately.")
    writes = []
    backups = []
    for item in manifest.get("files") or []:
        rel = item["path"]
        dst = safe_target_path(target_root, rel)
        writes.append({"path": rel, "target": str(dst), "exists": dst.exists(), "bytes": item.get("bytes")})
    if not args.write:
        print(json.dumps({"dryRun": True, "targetRoot": str(target_root), "writes": writes, "warnings": manifest.get("warnings", [])}, indent=2, ensure_ascii=False))
        return
    target_root.mkdir(parents=True, exist_ok=True)
    backup_root = target_root / ".mesh" / "migrate" / "backups" / datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    with tarfile.open(bundle, "r:gz") as tar:
        members = {m.name: m for m in tar.getmembers()}
        for item in manifest.get("files") or []:
            rel = item["path"]
            member = members.get(rel)
            if not member or not member.isfile():
                die(f"Bundle missing file listed in manifest: {rel}")
            extracted = tar.extractfile(member)
            if not extracted:
                die(f"Could not read bundle file: {rel}")
            payload = extracted.read()
            digest = hashlib.sha256(payload).hexdigest()
            if digest != item.get("sha256"):
                die(f"Checksum mismatch for {rel}")
            dst = safe_target_path(target_root, rel)
            if dst.exists() and not args.no_backup:
                backup = safe_target_path(backup_root, rel)
                backup.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(dst, backup)
                backups.append(str(backup.relative_to(target_root)))
            dst.parent.mkdir(parents=True, exist_ok=True)
            atomic_write_bytes(dst, payload)
    success(f"✅ Applied migration capsule to {target_root}")
    if backups:
        print(f"Backups: {len(backups)} under {backup_root}")


# ── Remote QMD search ────────────────────────────────────────

def qmd_remote_target(host, user=None):
    if not host or any(ch.isspace() for ch in host):
        die("Invalid remote QMD host. Use a hostname/IP without spaces.")
    if user and any(ch.isspace() for ch in user):
        die("Invalid remote QMD user. Use a username without spaces.")
    return f"{user}@{host}" if user else host


def qmd_remote_path_prepend(value):
    # Non-interactive SSH shells often miss user tool dirs such as ~/.bun/bin.
    # Allow a conservative shell-expanded PATH prefix (no whitespace/control
    # operators) so clients can expose host-side qmd without modifying login
    # files or installing global symlinks.
    default = "$HOME/.bun/bin:$HOME/.local/bin:/opt/homebrew/bin"
    value = value or os.environ.get("QMD_REMOTE_PATH") or default
    if not re.match(r"^[A-Za-z0-9_.$/~:+-]+$", value):
        die("Invalid remote PATH prefix. Use colon-separated safe paths without spaces or shell operators.")
    return value


def build_qmd_remote_command(args):
    host = args.host or os.environ.get("QMD_REMOTE_HOST")
    user = args.user or os.environ.get("QMD_REMOTE_USER")
    workspace = args.workspace or os.environ.get("QMD_REMOTE_WORKSPACE")
    if not host:
        die("Remote QMD host is required. Pass --host or set QMD_REMOTE_HOST.")
    if not workspace:
        die("Remote QMD workspace is required. Pass --workspace or set QMD_REMOTE_WORKSPACE.")
    target = qmd_remote_target(host, user=user)
    script = args.script or os.environ.get("QMD_REMOTE_SCRIPT") or "scripts/qmd_search_fallback.py"
    remote_path = qmd_remote_path_prepend(args.remote_path)
    remote_args = [args.query, "-n", str(args.num), "--timeout", str(args.timeout)]
    for collection in args.collection or []:
        remote_args += ["-c", collection]
    if args.cache or os.environ.get("QMD_REMOTE_CACHE"):
        remote_args += ["--cache", args.cache or os.environ.get("QMD_REMOTE_CACHE")]
    if args.json:
        remote_args.append("--json")
    if args.no_query_after_vsearch:
        remote_args.append("--no-query-after-vsearch")
    if args.min_search_score is not None:
        remote_args += ["--min-search-score", str(args.min_search_score)]
    if args.min_vsearch_score is not None:
        remote_args += ["--min-vsearch-score", str(args.min_vsearch_score)]
    qmd_cmd = " ".join(shlex.quote(x) for x in ["python3", script] + remote_args)
    remote_cmd = f"set -euo pipefail; export PATH={remote_path}:$PATH; cd {shlex.quote(workspace)}; {qmd_cmd}"
    ssh_cmd = [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", f"ConnectTimeout={args.ssh_timeout}",
        target,
        remote_cmd,
    ]
    return {"target": target, "workspace": workspace, "script": script, "remoteCommand": remote_cmd, "sshCommand": ssh_cmd}


