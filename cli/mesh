def handle_mesh_mcp_tool(root, name, args):
    args = args or {}
    if name == "mesh_agents_list":
        paths = mesh_paths(root)
        pulses = []
        if paths["pulse"].exists():
            for p in sorted(paths["pulse"].glob("*.json")):
                with contextlib.suppress(Exception):
                    pulses.append(read_json(p))
        tasks = []
        if paths["active"].exists():
            for p in sorted(paths["active"].glob("*.json")):
                with contextlib.suppress(Exception):
                    tasks.append(read_json(p))
        return mcp_tool_text({"pulses": pulses, "activeTasks": tasks})
    if name == "mesh_sessions_list":
        sessions = [s for s in load_mcp_sessions(root) if is_mcp_shared_session_supported(s)]
        if args.get("agent"):
            agent = normalize_mcp_shared_agent(args.get("agent"), "agent")
            sessions = [s for s in sessions if s.get("agent") == agent]
        return mcp_tool_text([{k: v for k, v in s.items() if k != "_path"} for s in sessions])
    if name == "mesh_access_request":
        req = create_mcp_access_request(root, args.get("requestingAgent"), args.get("targetSession"), args.get("reason"), args.get("scope", "full"), args.get("currentSession"))
        return mcp_tool_text(req)
    if name == "mesh_transcript_read":
        result = read_mcp_transcript_authorized(root, args.get("requestingAgent"), args.get("targetSession"), mode=args.get("mode", "full"), current_session=args.get("currentSession"), reason=args.get("reason"), auto_request=True)
        return mcp_tool_text(result)
    if name == "mesh_context_pack":
        result = make_mcp_context_pack(root, args.get("requestingAgent"), args.get("targetSession"), current_session=args.get("currentSession"), token_budget=args.get("tokenBudget", 4000), reason=args.get("reason"), auto_request=True)
        return mcp_tool_text(result)
    if name == "mesh_mcp_servers_list":
        return mcp_tool_text(load_mcp_servers(root))
    if name == "mesh_mcp_tools_list":
        server_name = args.get("server")
        server = load_mcp_servers(root).get("servers", {}).get(server_name)
        if not server:
            raise ValueError(f"Unknown downstream MCP server: {server_name}")
        return mcp_tool_text(call_stdio_mcp_server(server, "tools/list", {}, timeout=15))
    if name == "mesh_mcp_call":
        server_name = args.get("server")
        server = load_mcp_servers(root).get("servers", {}).get(server_name)
        if not server:
            raise ValueError(f"Unknown downstream MCP server: {server_name}")
        return mcp_tool_text(call_stdio_mcp_server(server, "tools/call", {"name": args.get("tool"), "arguments": args.get("input") or {}}, timeout=15))
    raise ValueError(f"Unknown tool: {name}")


def cmd_mcp_serve(args):
    root = require_mesh_root()
    ensure_mcp_structure(root)
    stdin = sys.stdin.buffer
    stdout = sys.stdout.buffer
    while True:
        msg = read_mcp_wire_message(stdin)
        if msg is None:
            break
        method = msg.get("method")
        req_id = msg.get("id")
        if method == "initialize":
            write_mcp_wire_message(stdout, {"jsonrpc": "2.0", "id": req_id, "result": {"protocolVersion": "2024-11-05", "capabilities": {"tools": {}}, "serverInfo": {"name": "agent-mesh-mcp-experimental", "version": VERSION}}})
        elif method == "notifications/initialized":
            continue
        elif method == "tools/list":
            write_mcp_wire_message(stdout, {"jsonrpc": "2.0", "id": req_id, "result": {"tools": mesh_mcp_tool_definitions()}})
        elif method == "tools/call":
            params = msg.get("params") or {}
            try:
                result = handle_mesh_mcp_tool(root, params.get("name"), params.get("arguments") or {})
                write_mcp_wire_message(stdout, {"jsonrpc": "2.0", "id": req_id, "result": result})
            except Exception as e:
                write_mcp_wire_message(stdout, {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32000, "message": str(e)}})
        else:
            if req_id is not None:
                write_mcp_wire_message(stdout, {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": f"Method not found: {method}"}})


def cmd_qmd_remote_search(args):
    built = build_qmd_remote_command(args)
    if args.print_command:
        print(json.dumps(built, indent=2, ensure_ascii=False))
        return
    timeout = max(5, int(args.ssh_timeout)) + max(1, int(args.timeout)) + 10
    proc = subprocess.run(built["sshCommand"], text=True, capture_output=True, timeout=timeout)
    if proc.stdout:
        print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)
    if proc.returncode != 0:
        raise SystemExit(proc.returncode)


