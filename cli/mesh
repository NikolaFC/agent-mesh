    print(f"Set this for agents that run elsewhere: export MESH_ROOT={target}")


def cmd_state_tailscale_host_init(args):
    bare = ensure_bare_repo(Path(args.repo_path))
    state_root = Path(args.state_root).expanduser().resolve()
    if state_root.exists() and any(state_root.iterdir()) and not (state_root / ".mesh").is_dir():
        die(f"State root exists but is not an Agent Mesh root: {state_root}")
    state_root.mkdir(parents=True, exist_ok=True)
    ensure_mesh_structure(state_root)
    configure_state_remote(state_root, str(bare), branch=args.branch, allow_project_repo=True)
    if args.seed_from:
        seed = Path(args.seed_from).expanduser().resolve()
        source_mesh = seed if seed.name == ".mesh" else seed / ".mesh"
        if not source_mesh.is_dir():
            die(f"Seed path does not contain a .mesh directory: {seed}")
        shutil.copytree(source_mesh, state_root / ".mesh", dirs_exist_ok=True, ignore=shutil.ignore_patterns(".lock", ".state-sync"))
        configure_state_remote(state_root, str(bare), branch=args.branch, allow_project_repo=True)
    committed = git_commit_pending(state_root, args.message or f"mesh: initialize Tailscale host state {now_iso()}")
    git_cmd(state_root, ["push", "-u", "origin", args.branch])
    success(f"✅ Tailscale mesh state host initialized at {state_root} -> {bare} ({'committed' if committed else 'no local changes'})")
    if args.host:
        remote = tailscale_git_remote(args.host, str(bare), user=args.user)
        print("Client join command:")
        user_part = f" --user {args.user}" if args.user else ""
        print(f"  mesh state tailscale join --host {args.host}{user_part} --repo-path {bare} --target ~/agent-mesh-state")


def cmd_state_tailscale_join(args):
    target = Path(args.target).expanduser().resolve()
    remote = tailscale_git_remote(args.host, args.repo_path, user=args.user)
    if target.exists() and any(target.iterdir()):
        die(f"Target is not empty: {target}. Move it aside or choose a fresh --target; join will not overwrite existing state.")
    clone_state_root(remote, target, branch=args.branch)
    if args.sync:
        git_cmd(target, ["pull", "--rebase", "origin", args.branch])
        rebuild_indexes(target, mesh_paths(target))
    success(f"✅ Joined Tailscale SSH mesh state at {target}")
    print(f"Set this for agents that run elsewhere: export MESH_ROOT={target}")


def cmd_state_status(args):
    root = require_mesh_root()
    _config, _state, remote, branch = state_sync_config(root)
    top = git_top_level(root)
    dirty = None
    if top == root.resolve():
        dirty = bool(git_cmd(root, ["status", "--porcelain"], check=False).stdout.strip())
    data = {"root": str(root), "remote": remote, "branch": branch, "gitRoot": str(top) if top else "", "dirty": dirty}
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return
    print(f"Root: {data['root']}")
    print(f"Remote: {remote or '(not configured)'}")
    print(f"Branch: {branch}")
    print(f"Git root: {data['gitRoot'] or '(not a git repo)'}")
    print(f"Dirty: {'unknown' if dirty is None else ('yes' if dirty else 'no')}")


def cmd_state_push(args):
    root = require_mesh_root()
    _config, _state, remote, branch = state_sync_config(root)
    if not remote:
        die("Mesh state remote is not configured. Run `mesh state configure --remote <git-url>`.")
    ensure_state_git(root, remote=remote, branch=branch, allow_project_repo=args.allow_project_repo)
    message = args.message or f"mesh: sync state {now_iso()}"
    committed = git_commit_pending(root, message)
    git_cmd(root, ["push", "-u", "origin", branch])
    success(f"✅ Mesh state pushed ({'committed changes' if committed else 'no local changes'})")


def cmd_state_pull(args):
    root = require_mesh_root()
    _config, _state, remote, branch = state_sync_config(root)
    if not remote:
        die("Mesh state remote is not configured. Run `mesh state configure --remote <git-url>`.")
    ensure_state_git(root, remote=remote, branch=branch, allow_project_repo=args.allow_project_repo)
    if git_cmd(root, ["status", "--porcelain"], check=False).stdout.strip() and not args.autocommit:
        die("Local mesh state has uncommitted changes. Use `mesh state sync` or `mesh state pull --autocommit`.")
    if args.autocommit:
        git_commit_pending(root, args.message or f"mesh: local state before pull {now_iso()}")
    if git_remote_branch_exists(root, branch):
        git_cmd(root, ["pull", "--rebase", "origin", branch])
    else:
        warn(f"Remote branch '{branch}' does not exist yet; nothing to pull.")
    ensure_mesh_structure(root)
    rebuild_indexes(root, mesh_paths(root))
    success("✅ Mesh state pulled")


def cmd_state_sync(args):
    root = require_mesh_root()
    _config, _state, remote, branch = state_sync_config(root)
    if not remote:
        die("Mesh state remote is not configured. Run `mesh state configure --remote <git-url>`.")
    ensure_state_git(root, remote=remote, branch=branch, allow_project_repo=args.allow_project_repo)
    message = args.message or f"mesh: sync state {now_iso()}"
    local_committed = git_commit_pending(root, message)
    if git_remote_branch_exists(root, branch):
        git_cmd(root, ["pull", "--rebase", "origin", branch])
    else:
        warn(f"Remote branch '{branch}' does not exist yet; pushing initial state.")
    ensure_mesh_structure(root)
    rebuild_indexes(root, mesh_paths(root))
    rebuilt_committed = git_commit_pending(root, f"mesh: rebuild indexes after sync {now_iso()}")
    git_cmd(root, ["push", "-u", "origin", branch])
    changed = local_committed or rebuilt_committed
    success(f"✅ Mesh state synced ({'changes pushed' if changed else 'already up to date'})")


